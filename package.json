{
  "name": "thedoor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter @thedoor/web dev",
    "dev:api": "bun run --filter @thedoor/api dev",
    "build": "bun run --bun --filter '*' build",
    "build:web": "bun run --bun --filter @thedoor/web build",
    "build:api": "bun run --bun --filter @thedoor/api build",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "deploy": "bun scripts/deploy.mjs",
    "dns": "bun scripts/cloudflare-dns.mjs"
  }
}
