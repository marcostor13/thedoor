# ---------------------------------------------------------------------------
# The Door — plantilla de variables de entorno
#
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore: NUNCA se commitean valores reales.
#
# En CI/CD estos valores viven en GitHub Secrets; en runtime, en las variables
# de entorno de cada aplicación dentro de Coolify.
# ---------------------------------------------------------------------------

# --- Repositorio (usado por el script de aprovisionamiento en Coolify) -------
# PAT de GitHub con scope `repo`, para que Coolify pueda clonar el repositorio.
GITHUB_TOKEN=
GITHUB_OWNER=marcostor13
GITHUB_REPO=thedoor

# --- Coolify (PaaS self-hosted donde corren frontend y backend) -------------
# URL base de la instancia de Coolify, sin barra final.
COOLIFY_URL=
# API token de Coolify (Keys & Tokens -> API tokens). Formato "<id>|<secreto>".
COOLIFY_TOKEN=
# UUID del proyecto y del servidor destino dentro de Coolify. Ningún script
# las lee: hacen falta para crear las aplicaciones. Se obtienen con
# `bun run deploy -- --list`.
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
# Nombre del entorno dentro del proyecto de Coolify.
COOLIFY_ENVIRONMENT=production

# UUID de cada una de las dos aplicaciones ya creadas en Coolify. Estas SÍ son
# imprescindibles: son las que dispara el despliegue, tanto en local como desde
# GitHub Actions (secretos COOLIFY_WEB_UUID / COOLIFY_API_UUID).
# Se sacan con `bun run deploy -- --list` una vez creadas las aplicaciones.
COOLIFY_WEB_UUID=
COOLIFY_API_UUID=

# --- Dominios públicos ------------------------------------------------------
FRONTEND_DOMAIN=thedoorpr.com
BACKEND_DOMAIN=api.thedoorpr.com

# --- Cloudflare (DNS de los dominios de arriba) -----------------------------
# Token de API con permisos Zone:DNS:Edit sobre la zona correspondiente.
CLOUDFLARE_API_TOKEN=
# Zona sobre la que se crean los registros. Si se omite, el script la resuelve
# a partir del dominio raíz de FRONTEND_DOMAIN.
CLOUDFLARE_ZONE_NAME=thedoorpr.com
# Identificador del Cloudflare Tunnel por el que Coolify publica sus apps.
# Esta infraestructura NO usa registros A: cada hostname es un CNAME a
# <tunnel>.cfargotunnel.com con el proxy activado (obligatorio: ese dominio
# solo resuelve desde el borde de Cloudflare).
CLOUDFLARE_TUNNEL_ID=
# Alternativa al túnel: IPv4 pública del servidor, si algún día se publica
# directamente contra ella. Con CLOUDFLARE_TUNNEL_ID definido no se usa.
SERVER_IP=

# --- Resolución DNS ----------------------------------------------------------
# Servidores DNS que usa Node para sus propias resoluciones (separados por
# comas). Necesario cuando el resolver del sistema no puede resolver el
# registro SRV de `mongodb+srv://` aunque el resto de DNS funcione bien.
NODE_DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Backend (NestJS) -------------------------------------------------------
# Cadena de conexión de MongoDB Atlas, incluida la base de datos.
MONGO_URI=
PORT=3000
NODE_ENV=production
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=https://thedoorpr.com,http://localhost:4321
# Secreto para firmar los JWT del panel de administración.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Correo saliente (Resend) ------------------------------------------------
# La confirmación de alta que recibe quien se registra en la landing.
#
# Es OPCIONAL: sin RESEND_API_KEY y MAIL_FROM la API arranca igual, avisa una
# vez en el log y sigue registrando gente — simplemente no confirma nada por
# correo.
#
# La clave se saca de resend.com/api-keys y basta con permiso de envío. Es un
# secreto: no tiene que acabar en el repositorio ni en ninguna PUBLIC_*.
RESEND_API_KEY=
# Remitente, con nombre visible. Su dominio tiene que estar verificado en
# Resend (resend.com/domains) con sus registros SPF y DKIM publicados, o cada
# envío se rechaza con un 403 «domain is not verified».
MAIL_FROM=The Door PR <hola@thedoorpr.com>
# A dónde va la respuesta si contestan. Si se omite, se responde al remitente.
MAIL_REPLY_TO=
# Quién recibe el aviso cuando alguien escribe por el formulario de contacto de
# la portada. Varias direcciones, separadas por comas. Tiene que ser un buzón
# que exista de verdad: sin esta variable el mensaje se guarda en Mongo igual,
# pero nadie se entera por correo.
MAIL_NOTIFY_TO=
# Base pública del sitio: de aquí cuelga la imagen del correo y el botón.
SITE_URL=https://thedoorpr.com

# --- Altas de la landing -----------------------------------------------------
# Las altas NO se guardan en Mongo: van al formulario público de la plataforma.
# Es la única escritura del alta, así que sin esta variable `POST /signup`
# responde error en vez de dar por buena una inscripción que no se ha guardado.
#
# La URL completa de envío, tal cual la da la plataforma:
#   https://<host>/public/forms/<clave-pública>/submit
#
# Los nombres de los campos que espera —nombre, email, whatsapp e instagram—
# salen de la definición del formulario, que se consulta sin clave:
#   https://<host>/public/forms/<clave-pública>
# Si se cambia de formulario, hay que mirar ahí antes: los campos de uno no
# tienen por qué llamarse igual que los del otro (`SignupFormFields`).
SIGNUP_FORM_URL=

# --- Frontend (Astro) -------------------------------------------------------
# URL pública del backend. Las variables PUBLIC_* se inyectan en el bundle del
# navegador, así que aquí no va nunca ningún secreto.
PUBLIC_API_URL=https://api.thedoorpr.com
PUBLIC_SITE_URL=https://thedoorpr.com

# Número de WhatsApp del botón «Hablemos ahora mismo» de la portada. Se escribe
# legible (el enlace de wa.me se queda solo con los dígitos). Si no se define,
# la web usa el número de la casa, que vive en data/navigation.ts.
PUBLIC_WHATSAPP_PHONE=+51 944 092 013
