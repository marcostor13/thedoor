---
import Logo from './Logo.astro'
import DoorGlyph from './DoorGlyph.astro'
import { SITE } from '../data/navigation'

const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="container footer__inner">
    <a class="footer__brand" href="/#top" aria-label={`${SITE.name} — inicio`}>
      <DoorGlyph class="footer__glyph" id="footer" />
      <Logo class="footer__wordmark" />
    </a>
    <p class="footer__legal">
      © {year} {SITE.name.toUpperCase()} — Casa de hospitalidad en Lima
    </p>
    <p class="footer__hours">After hours — solo con cita previa</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--sp-lg);
    border-top: 1px solid var(--c-border);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md);
    align-items: center;
    justify-content: space-between;
  }

  .footer__brand {
    display: inline-flex;
    gap: 0.625rem;
    align-items: center;
    text-decoration: none;
  }

  :global(.footer__glyph) {
    width: auto;
    height: 1.4rem;
  }

  .footer__legal,
  .footer__hours {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    color: var(--c-fg-muted);
  }
</style>
