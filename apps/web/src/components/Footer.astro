---
import DoorMark from './DoorMark.astro'
import Logo from './Logo.astro'
import { SITE } from '../data/navigation'

const year = new Date().getFullYear()

const contactRows = [
  { label: 'Locales', value: 'venues@thedoor.pe' },
  { label: 'Guest list', value: 'guestlist@thedoor.pe' },
  { label: 'Prensa', value: 'press@thedoor.pe' },
  { label: 'Citas', value: 'appointments@thedoorpr.com', note: '* Solo con cita previa' },
]
---

<footer class="footer">
  <div class="container footer__inner">
    {/* La firma del pie es el mismo lockup que preside la portada —la puerta
        de neón, el wordmark con sus rombos y el filete rojo—, solo que más
        pequeño. Antes era el glifo compacto de la cabecera junto a un
        wordmark en tres líneas que no aparecía en ningún otro sitio: dos
        logos distintos para la misma casa. */}
    <a class="footer__brand" href="/#top" aria-label={`${SITE.name} — inicio`}>
      <DoorMark class="footer__mark" id="footer" />
      <Logo class="footer__wordmark" />
      <span class="footer__rule" aria-hidden="true"></span>
    </a>

    {/* La pregunta de la portada, con la misma letra que allí. */}
    <p class="footer__slogan display">
      <span>Are you in?</span>
      <em>Or are you out?</em>
    </p>

    <dl class="footer__rows">
      {
        contactRows.map((row) => (
          <div class="footer__row">
            <dt>{row.label}</dt>
            <dd>
              <a href={`mailto:${row.value}`}>{row.value}</a>
              {row.note && <span class="footer__note">{row.note}</span>}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="container footer__legal">
    <p>© {year} {SITE.name.toUpperCase()} — Agencia de relaciones públicas Lima - Perú</p>
  </div>
</footer>

<style>
  .footer {
    padding-block-start: var(--sp-2xl);
    border-top: 1px solid var(--c-border);
  }

  /* Marca a la izquierda, direcciones a la derecha; el eslogan cuelga del
     lockup, que es de donde cuelga en la portada. */
  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-md) clamp(var(--sp-xl), 8vw, 10rem);
    align-items: start;
  }

  /* Apilado y centrado, como en el hero: puerta, wordmark, filete. */
  .footer__brand {
    display: inline-grid;
    justify-items: center;
    gap: var(--sp-sm);
    justify-self: start;
    text-decoration: none;
  }

  /* Misma regla que en la portada: la puerta se mide por altura y el
     aspect-ratio deduce el ancho. */
  :global(.footer__mark) {
    aspect-ratio: 24 / 34;
    width: auto;
    height: clamp(9rem, 14vw, 13rem);
    transition: filter var(--dur-base) var(--ease-out);
  }

  .footer__brand:hover :global(.footer__mark),
  .footer__brand:focus-visible :global(.footer__mark) {
    filter: brightness(1.2);
  }

  :global(.footer__wordmark) {
    font-size: var(--fs-lg);
  }

  .footer__rule {
    width: 2.5rem;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-accent);
  }

  /* Fuera de pantalla la puerta se queda quieta: sus bucles de luz no se
     ven y no tienen por qué gastar. Sin JS no se pausa nunca. */
  :global(html.js) .footer:not(.is-onscreen) :global(.footer__mark *) {
    animation-play-state: paused;
  }

  .footer__slogan {
    grid-column: 1;
    display: grid;
    margin-block-start: var(--sp-lg);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1.05;
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg);
  }

  .footer__rows {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    align-content: start;
    margin: 0;
  }

  .footer__row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-md);
    padding-block: var(--sp-sm);
    border-top: 1px solid var(--c-border);
  }

  /* Las etiquetas acompañan al dato, como las de los formularios: en gris.
     El rojo del pie ya lo llevan la puerta, el filete y la pregunta. */
  .footer__row dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .footer__row dd {
    display: grid;
    gap: var(--sp-3xs);
    margin: 0;
    text-align: end;
    color: var(--c-fg);
  }

  .footer__row a {
    color: inherit;
    text-decoration: none;
  }

  .footer__row a:hover {
    color: var(--c-accent);
  }

  .footer__note {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
  }

  .footer__legal {
    margin-block-start: var(--sp-2xl);
    padding-block: var(--sp-md);
    border-top: 1px solid var(--c-border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    color: var(--c-fg-muted);
  }

  @media (max-width: 860px) {
    .footer__brand {
      justify-self: center;
    }

    .footer__slogan {
      text-align: center;
    }

    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-lg);
    }

    .footer__slogan,
    .footer__rows {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>

<script>
  /**
   * Marca el pie como visible mientras lo está, para que el CSS pause los
   * bucles de luz de la puerta cuando nadie los ve. El ClientRouter cambia el
   * pie en cada navegación, así que el observador se rehace con él.
   */
  let observer: IntersectionObserver | undefined

  function initFooterMark(): void {
    observer?.disconnect()

    const footer = document.querySelector<HTMLElement>('.footer')
    if (!footer || !('IntersectionObserver' in window)) {
      footer?.classList.add('is-onscreen')
      return
    }

    observer = new IntersectionObserver(([entry]) => {
      footer.classList.toggle('is-onscreen', entry.isIntersecting)
    })
    observer.observe(footer)
  }

  initFooterMark()
  document.addEventListener('astro:after-swap', initFooterMark)
</script>
