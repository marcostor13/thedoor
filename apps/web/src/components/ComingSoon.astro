---
/**
 * Página de espera — lo único que ve el visitante mientras la web esté en
 * «próximamente». La puerta se abre entera, entra el wordmark y ahí se queda:
 * ni cabecera, ni scroll, ni una sola línea del sitio detrás.
 *
 * No es un cartel encima de la web: el bloque `is:global` de abajo retira del
 * documento todo lo que no sea esta verja. La web vuelve —entera y de una
 * pieza— cuando `?develop=true` pone `data-develop` en <html>; de eso se
 * encargan el script en línea de Layout.astro y scripts/gate.ts.
 *
 * Para levantarla del todo cuando el sitio salga: quitar `soon` del <Layout>
 * de pages/index.astro. Este componente no hace falta tocarlo.
 */
import DoorMark from './DoorMark.astro'
import Logo from './Logo.astro'
---

<div id="soon" class="soon" data-door-scene>
  <div class="soon__vignette" aria-hidden="true"></div>

  <div class="soon__stage">
    <DoorMark class="soon__mark" id="soon" staged entrance="full" />

    <div class="soon__brand">
      <Logo class="soon__wordmark" />
      <span class="soon__rule" aria-hidden="true"></span>
      <h1 class="soon__title">Coming Soon</h1>
      <p class="soon__note">Nuevas novedades — Lima, Perú</p>
    </div>
  </div>
</div>

<style is:global>
  /* --- La verja ------------------------------------------------------------
     Mientras la portada esté en «próximamente» y no haya permiso, todo lo que
     no sea la verja desaparece del documento: no se lee, no se tabula, no se
     busca con Ctrl+F. Tapar con un overlay no bastaba.
     ---------------------------------------------------------------------- */
  html[data-soon]:not([data-develop]) {
    overflow: hidden;
  }

  html[data-soon]:not([data-develop]) body > *:not(.soon) {
    display: none !important;
  }

  /* Con permiso la verja no llega a verse ni un fotograma; gate.ts la retira
     del DOM en cuanto puede. */
  html[data-develop] .soon {
    display: none;
  }
</style>

<style>
  .soon {
    position: fixed;
    inset: 0;
    z-index: var(--z-gate);
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: var(--sp-lg) var(--gutter);
    background: var(--c-bg);
  }

  /* La misma viñeta que cierra la secuencia de entrada: concentra la mirada
     en la puerta y disimula los bordes de la pantalla. */
  .soon__vignette {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      circle at 50% 50%,
      rgb(255 26 37 / 0.07) 0%,
      rgb(0 0 0 / 0) 38%,
      rgb(0 0 0 / 0.85) 78%
    );
  }

  .soon__stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(var(--sp-md), 4vh, var(--sp-xl));
  }

  /* Como en el hero: la puerta se mide por ALTURA, que es lo que compite con
     el resto de la pantalla, y el aspect-ratio deduce el ancho. */
  :global(.soon__mark) {
    aspect-ratio: 24 / 34;
    width: auto;
    height: min(52vh, 38rem);
    max-width: 84vw;
  }

  .soon__brand {
    display: grid;
    justify-items: center;
    gap: var(--sp-sm);
    text-align: center;
  }

  :global(.soon__wordmark) {
    font-size: var(--fs-xl);
  }

  .soon__rule {
    width: 2.5rem;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-accent);
  }

  .soon__title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg);
  }

  .soon__note {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  /* --- Entrada -------------------------------------------------------------
     La marca entra sola (DoorMark `staged` + entrance="full", ~4,8 s) y
     scripts/door.ts pone `scene--enter` aquí al arrancarla. El texto va
     detrás, escalonado, igual que en el hero. Sin JS todo nace visible.
     ---------------------------------------------------------------------- */
  :global(html.js) .soon__brand > * {
    opacity: 0;
  }

  .soon.scene--enter :global(.soon__wordmark) {
    animation: soon-rise 1000ms var(--ease-out) 3600ms both;
  }

  .soon.scene--enter .soon__rule {
    animation: soon-rule 900ms var(--ease-out) 3800ms both;
  }

  .soon.scene--enter .soon__title {
    animation: soon-rise 1100ms var(--ease-out) 3950ms both;
  }

  .soon.scene--enter .soon__note {
    animation: soon-rise 1000ms var(--ease-out) 4250ms both;
  }

  @keyframes soon-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* El filete no aparece: se abre desde el centro, como la propia puerta. */
  @keyframes soon-rule {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .soon__brand > * {
      opacity: 1;
    }
  }
</style>
