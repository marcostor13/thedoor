---
import DoorMark from './DoorMark.astro'
import Logo from './Logo.astro'

/**
 * Secuencia de entrada. Coreografía en cuatro tiempos sobre la marca de
 * DoorMark.astro, que ya trae su estado de reposo (puerta entreabierta al
 * 50 % y luces respirando). Aquí solo se «rebobina» ese estado al inicio
 * —puerta cerrada y a oscuras— y se le devuelve el control con calma:
 *
 *   0.1 – 1.2 s  la carpintería se dibuja trazo a trazo
 *   0.8 – 1.5 s  una cuchilla de luz aparece en el quicio y parpadea
 *   1.3 – 2.6 s  las hojas se abren hasta la mitad, con un punto de rebote
 *   1.8 – 3.5 s  la luz inunda: interior, abanico, rayos y derrame al suelo
 *   2.2 – 3.4 s  entran el wordmark y el kicker
 *   3.65 s      el overlay se retira (--dur-intro)
 */
---

<div id="intro" class="intro" role="presentation" aria-hidden="true">
  <div class="intro__vignette" aria-hidden="true"></div>

  <div class="intro__stage">
    <DoorMark class="intro__mark" id="intro" />

    <div class="intro__brand">
      <Logo class="intro__wordmark" />
      <p class="intro__kicker">PR House — Lima</p>
    </div>
  </div>

  <p class="intro__skip">Pulsa para entrar</p>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--c-bg);
    cursor: pointer;
  }

  .intro[hidden] {
    display: none;
  }

  .intro--done {
    animation: intro-out 800ms var(--ease-out) forwards;
  }

  /* Viñeta que se cierra sobre los bordes: concentra la mirada en la puerta. */
  .intro__vignette {
    position: absolute;
    inset: -10%;
    background: radial-gradient(
      circle at 50% 52%,
      rgb(255 26 37 / 0.07) 0%,
      rgb(0 0 0 / 0) 38%,
      rgb(0 0 0 / 0.85) 78%
    );
    opacity: 0;
    animation: intro-fade 1600ms var(--ease-out) 600ms forwards;
  }

  .intro__stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(var(--sp-md), 4vh, var(--sp-xl));
  }

  :global(.intro__mark) {
    aspect-ratio: 24 / 34;
    width: auto;
    height: min(58vh, 40rem);
    max-width: 88vw;
  }

  /* --- Rebobinado del estado de reposo ------------------------------------ */

  /* Carpintería: se dibuja sola. `pathLength="1"` normaliza cada trazo. */
  :global(.intro__mark .dm-draw) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: intro-draw 1100ms var(--ease-in-out) 120ms forwards;
  }

  :global(.intro__mark .dm-fan .dm-draw) {
    animation-delay: 620ms;
    animation-duration: 900ms;
  }

  :global(.intro__mark .dm-halo) {
    animation: intro-halo 2600ms var(--ease-out) 700ms both;
  }

  :global(.intro__mark .dm-star) {
    animation: intro-star 1200ms var(--ease-out) 1500ms both;
  }

  /* Cuchilla de luz: nace fina en el quicio cerrado y crece hasta la
     columna que la marca luce en reposo (--seam: 6). */
  :global(.intro__mark .dm-blade) {
    animation:
      intro-blade 1900ms var(--ease-door) 800ms both,
      intro-blade-flicker 1100ms linear 820ms;
  }

  :global(.intro__mark .door-leaf--left),
  :global(.intro__mark .door-leaf--right) {
    animation: intro-leaf 1350ms var(--ease-door) 1280ms both;
  }

  /* El vaivén de reposo se multiplicaría con la apertura y la emborronaría:
     durante la secuencia las hojas solo hacen una cosa. */
  :global(.intro__mark .door-leaf__sway),
  :global(.intro__mark .dm-frame) {
    animation: none;
  }

  :global(.intro__mark .dm-inside) {
    animation: intro-inside 1500ms var(--ease-out) 1300ms both;
  }

  :global(.intro__mark .dm-rays) {
    animation: intro-rays 1800ms var(--ease-out) 1750ms both;
  }

  :global(.intro__mark .dm-spill) {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: intro-spill 1600ms var(--ease-out) 1900ms both;
  }

  /* --- Wordmark ------------------------------------------------------------ */

  .intro__brand {
    display: grid;
    justify-items: center;
    gap: var(--sp-xs);
    text-align: center;
  }

  :global(.intro__wordmark) {
    font-size: var(--fs-xl);
    opacity: 0;
    animation: intro-word 1300ms var(--ease-out) 2150ms forwards;
  }

  .intro__kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-fg-muted);
    opacity: 0;
    animation: intro-fade 900ms var(--ease-out) 2500ms forwards;
  }

  .intro__skip {
    position: absolute;
    bottom: clamp(1.5rem, 5vh, 3rem);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
    opacity: 0;
    animation: intro-skip 900ms var(--ease-out) 1800ms forwards;
  }

  /* --- Keyframes ------------------------------------------------------------ */

  @keyframes intro-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes intro-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes intro-skip {
    to {
      opacity: 0.45;
    }
  }

  @keyframes intro-halo {
    0% {
      opacity: 0;
      transform: scale(0.82);
    }
    70% {
      opacity: 1;
      transform: scale(1.06);
    }
    100% {
      opacity: 0.85;
      transform: scale(1);
    }
  }

  @keyframes intro-star {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    60% {
      opacity: 1;
      transform: scale(1.25);
    }
    100% {
      opacity: 0.9;
      transform: scale(1);
    }
  }

  @keyframes intro-blade {
    0% {
      opacity: 0;
      transform: scaleX(0.2) scaleY(0.25);
    }
    22% {
      opacity: 1;
      transform: scaleX(0.5) scaleY(1);
    }
    55% {
      opacity: 1;
      transform: scaleX(1.4) scaleY(1);
    }
    100% {
      opacity: 1;
      transform: scaleX(6) scaleY(1);
    }
  }

  @keyframes intro-blade-flicker {
    0%,
    26%,
    32%,
    58%,
    66%,
    100% {
      filter: none;
    }
    29% {
      filter: brightness(0.35);
    }
    62% {
      filter: brightness(0.55);
    }
  }

  /* La hoja gira: escala hacia el gozne, pasa un punto de la marca y vuelve,
     mientras su cara interior recibe la luz que sale del hueco. */
  @keyframes intro-leaf {
    0% {
      transform: scaleX(1);
      filter: brightness(0.3) saturate(0.6);
    }
    35% {
      filter: brightness(0.85) saturate(1);
    }
    68% {
      transform: scaleX(0.4);
      filter: brightness(1.35);
    }
    100% {
      transform: scaleX(0.5);
      filter: brightness(1);
    }
  }

  @keyframes intro-inside {
    0% {
      opacity: 0;
      filter: brightness(0.2);
    }
    55% {
      opacity: 1;
      filter: brightness(1.7);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  @keyframes intro-rays {
    0% {
      opacity: 0;
      transform: scale(0.4);
    }
    45% {
      opacity: 0.9;
      transform: scale(1.12);
    }
    100% {
      opacity: 0.62;
      transform: scale(1);
    }
  }

  @keyframes intro-spill {
    0% {
      opacity: 0;
      transform: scaleX(0.15);
    }
    60% {
      opacity: 1;
      transform: scaleX(1.08);
    }
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes intro-word {
    0% {
      opacity: 0;
      letter-spacing: 0.9em;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      letter-spacing: var(--ls-widest);
      transform: translateY(0);
    }
  }

  @keyframes intro-out {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      visibility: hidden;
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>

<script>
  import { announceIntro } from '../scripts/door'

  const STORAGE_KEY = 'thedoor:intro-seen'

  function runIntro(): void {
    const intro = document.getElementById('intro')
    if (!intro) return

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Ya vista en esta sesión, o el usuario pidió menos movimiento:
    // se retira sin animar y el scroll no llega a bloquearse. La puerta del
    // hero se queda entonces con la apertura completa, que aquí no se cuenta.
    if (prefersReducedMotion || sessionStorage.getItem(STORAGE_KEY) === '1') {
      intro.remove()
      announceIntro('skipped')
      return
    }

    document.body.style.overflow = 'hidden'

    let finished = false

    const finish = (): void => {
      if (finished) return
      finished = true

      sessionStorage.setItem(STORAGE_KEY, '1')
      document.body.style.overflow = ''
      intro.classList.add('intro--done')
      intro.addEventListener('animationend', () => intro.remove(), { once: true })

      // Se avisa al arrancar el fundido, no al terminarlo: así la puerta del
      // hero se enciende por detrás del overlay que se va y el relevo entre
      // las dos marcas se lee como un solo gesto.
      announceIntro('played')
    }

    // La secuencia nunca es una cárcel: un clic o una tecla entran ya.
    intro.addEventListener('pointerdown', finish, { once: true })
    window.addEventListener('keydown', finish, { once: true })

    // Red de seguridad: si la secuencia no termina sola (pestaña en segundo
    // plano, fuente sin cargar), el overlay no puede quedarse bloqueando
    // la página para siempre.
    const total =
      Number.parseInt(getComputedStyle(intro).getPropertyValue('--dur-intro'), 10) || 3650

    window.setTimeout(finish, total)
  }

  runIntro()
  document.addEventListener('astro:after-swap', runIntro)
</script>
