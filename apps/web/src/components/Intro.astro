---
import DoorMark from './DoorMark.astro'
---

<div id="intro" class="intro" role="presentation" aria-hidden="true">
  <div class="intro__stage">
    <DoorMark class="intro__mark" id="intro" />
    <p class="intro__label">THE&nbsp;&nbsp;DOOR&nbsp;&nbsp;PR</p>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    display: grid;
    place-items: center;
    background: var(--c-bg);
  }

  .intro[hidden] {
    display: none;
  }

  .intro--done {
    animation: intro-out var(--dur-slow) var(--ease-out) forwards;
  }

  .intro__stage {
    display: grid;
    justify-items: center;
    gap: var(--sp-lg);
    width: min(50vw, 22rem);
  }

  :global(.intro__mark) {
    width: 100%;
    height: auto;
    opacity: 0;
    animation: frame-draw-in var(--dur-slow) var(--ease-out) 100ms forwards;
  }

  :global(.intro__mark .door-frame) {
    opacity: 0;
    animation: frame-draw-in var(--dur-slow) var(--ease-out) 150ms forwards;
  }

  :global(.intro__mark .door-leaf--left) {
    animation: leaf-open-left 900ms var(--ease-out) 500ms backwards;
  }

  :global(.intro__mark .door-leaf--right) {
    animation: leaf-open-right 900ms var(--ease-out) 500ms backwards;
  }

  :global(.intro__mark .door-seam rect) {
    transform-origin: center;
    animation:
      seam-reveal 900ms var(--ease-out) 350ms backwards,
      seam-flicker 1400ms linear 350ms;
  }

  :global(.intro__mark .door-floor-spill) {
    opacity: 0;
    animation: frame-draw-in var(--dur-slow) var(--ease-out) 900ms forwards;
  }

  .intro__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-widest);
    color: var(--c-fg-muted);
    opacity: 0;
    animation: frame-draw-in var(--dur-slow) var(--ease-out) 1200ms forwards;
  }

  @keyframes frame-draw-in {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes leaf-open-left {
    0% {
      transform: scaleX(1.09);
      filter: brightness(0.55);
    }
    60% {
      transform: scaleX(0.88);
      filter: brightness(1.15);
    }
    100% {
      transform: scaleX(0.92);
      filter: brightness(1);
    }
  }

  @keyframes leaf-open-right {
    0% {
      transform: scaleX(1.09);
      filter: brightness(0.55);
    }
    60% {
      transform: scaleX(0.88);
      filter: brightness(1.15);
    }
    100% {
      transform: scaleX(0.92);
      filter: brightness(1);
    }
  }

  @keyframes seam-reveal {
    0% {
      opacity: 0;
      transform: scaleY(0.1) scaleX(0.4);
    }
    35% {
      opacity: 1;
      transform: scaleY(1.05) scaleX(2.2);
    }
    60% {
      opacity: 1;
      transform: scaleY(1) scaleX(1.6);
    }
    100% {
      opacity: 1;
      transform: scaleY(1) scaleX(1);
    }
  }

  @keyframes seam-flicker {
    0%,
    18%,
    22%,
    60%,
    64%,
    100% {
      opacity: 1;
    }
    20% {
      opacity: 0.65;
    }
    62% {
      opacity: 0.55;
    }
  }

  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro {
      display: none;
    }
  }
</style>

<script>
  const STORAGE_KEY = 'thedoor:intro-seen'

  function runIntro(): void {
    const intro = document.getElementById('intro')
    if (!intro) return

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches

    // Ya vista en esta sesión, o el usuario pidió menos movimiento:
    // se retira sin animar y el scroll no llega a bloquearse.
    if (prefersReducedMotion || sessionStorage.getItem(STORAGE_KEY) === '1') {
      intro.remove()
      return
    }

    document.body.style.overflow = 'hidden'

    const finish = (): void => {
      sessionStorage.setItem(STORAGE_KEY, '1')
      document.body.style.overflow = ''
      intro.classList.add('intro--done')
      intro.addEventListener('animationend', () => intro.remove(), {
        once: true,
      })
    }

    // Red de seguridad: si la secuencia no termina sola (pestaña en segundo
    // plano, fuente sin cargar), el overlay no puede quedarse bloqueando
    // la página para siempre.
    window.setTimeout(finish, Number.parseInt(getComputedStyle(intro).getPropertyValue('--dur-intro')) || 2200)
  }

  runIntro()
</script>
