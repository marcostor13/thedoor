---
/**
 * Formulario de contacto de la portada. Vive dos veces en la misma página
 * —una para locales, otra para la guest list—, así que todo lo que el
 * navegador exige único (los `id` de los campos) se deriva de la prop `id`,
 * y el script trabaja sobre todos los formularios marcados con
 * `data-contact-form`, no sobre uno concreto.
 */
import { SITE } from '../data/navigation'

interface Props {
  /** Sufijo de los `id` del formulario. Uno distinto por instancia. */
  id?: string
  /** Distingue el origen del envío en el backend: local o invitada. */
  kind?: 'venue' | 'guest'
  /** Texto del campo de mensaje: es también la llamada a la acción. */
  messageLabel?: string
  /** Ayuda dentro del campo de mensaje. */
  messagePlaceholder?: string
}

const {
  id = 'contact',
  kind,
  messageLabel = 'Mensaje',
  messagePlaceholder,
} = Astro.props

const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000'

/** wa.me solo acepta dígitos: el número se escribe legible en SITE. */
const whatsappHref = `https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}`
---

<form
  class="form"
  id={`form-${id}`}
  data-contact-form
  data-api={apiUrl}
  novalidate
  data-reveal
>
  {kind && <input type="hidden" name="kind" value={kind} />}

  <div class="form__field">
    <label class="form__label" for={`${id}-name`}>Nombre</label>
    <input
      class="form__input"
      id={`${id}-name`}
      name="name"
      type="text"
      required
      minlength="2"
      maxlength="120"
      autocomplete="name"
    />
  </div>

  <div class="form__field">
    <label class="form__label" for={`${id}-email`}>Email</label>
    <input
      class="form__input"
      id={`${id}-email`}
      name="email"
      type="email"
      required
      maxlength="180"
      autocomplete="email"
      inputmode="email"
    />
  </div>

  {/* Los dos opcionales comparten fila: pedir cuatro datos en columna parece
      más trabajo del que es, y ninguno de los dos frena el envío. */}
  <div class="form__row">
    <div class="form__field">
      <label class="form__label" for={`${id}-phone`}>
        Teléfono <span class="form__optional">— opcional</span>
      </label>
      <input
        class="form__input"
        id={`${id}-phone`}
        name="phone"
        type="tel"
        maxlength="40"
        autocomplete="tel"
        inputmode="tel"
        placeholder="+51 999 999 999"
      />
    </div>

    <div class="form__field">
      <label class="form__label" for={`${id}-instagram`}>
        Instagram <span class="form__optional">— opcional</span>
      </label>
      <input
        class="form__input"
        id={`${id}-instagram`}
        name="instagram"
        type="text"
        maxlength="200"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        placeholder="@usuario"
      />
    </div>
  </div>

  <div class="form__field">
    <label class="form__label" for={`${id}-message`}>{messageLabel}</label>
    <textarea
      class="form__input"
      id={`${id}-message`}
      name="message"
      rows="4"
      required
      minlength="10"
      maxlength="4000"
      placeholder={messagePlaceholder}></textarea>
  </div>

  {/* Trampa para bots: un campo que una persona nunca rellena. El backend
      descarta el envío si llega con contenido. */}
  <div class="form__honeypot" aria-hidden="true">
    <label for={`${id}-company`}>No rellenar</label>
    <input id={`${id}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form__actions">
    <button class="form__submit" type="submit">Enviar</button>

    {/* Quien no quiere esperar respuesta tiene la puerta de al lado abierta. */}
    <a
      class="form__whatsapp"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="form__whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.82c2.16 0 4.19.84 5.72 2.37a8.03 8.03 0 0 1 2.37 5.72c0 4.46-3.63 8.09-8.1 8.09a8.2 8.2 0 0 1-4.13-1.13l-.3-.18-3.11.82.83-3.04-.2-.31a8.02 8.02 0 0 1-1.23-4.29c0-4.46 3.63-8.05 8.15-8.05Zm-4.5 4.3c-.2 0-.53.08-.81.38-.28.3-1.07 1.04-1.07 2.54s1.1 2.95 1.25 3.15c.15.2 2.13 3.25 5.16 4.44.72.28 1.28.45 1.72.58.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.12-.28-.2-.58-.35-.3-.15-1.78-.88-2.05-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.23-.65.08-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.03-.53-.07-.15-.66-1.64-.93-2.24-.24-.57-.48-.5-.66-.5h-.6Z"
        ></path>
      </svg>
      Hablemos ahora mismo
    </a>
  </div>

  <p class="form__status" role="status" aria-live="polite"></p>
</form>

<style>
  .form {
    display: grid;
    gap: var(--sp-sm);
    /* A sangre el formulario podría estirarse media pantalla: los campos
       dejan de leerse como una unidad pasada esta medida. */
    max-width: var(--measure-md);
    margin-block-start: var(--sp-lg);
  }

  .form__field {
    display: grid;
    gap: var(--sp-3xs);
  }

  /* Teléfono e Instagram caben en una línea; en móvil se apilan solos. */
  .form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--sp-sm);
  }

  .form__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .form__optional {
    letter-spacing: var(--ls-normal);
    text-transform: none;
    opacity: 0.7;
  }

  .form__input {
    padding: var(--sp-xs) var(--sp-sm);
    color: var(--c-fg);
    background: var(--c-bg-elevated);
    border: 1px solid var(--c-border);
    border-radius: 0;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .form__input::placeholder {
    color: var(--c-fg-muted);
    opacity: 0.55;
  }

  .form__input:focus-visible {
    border-color: var(--c-accent);
  }

  .form__input[aria-invalid='true'] {
    border-color: #ef4444;
  }

  .form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-xs);
    align-items: stretch;
  }

  .form__submit,
  .form__whatsapp {
    display: inline-flex;
    gap: var(--sp-2xs);
    align-items: center;
    padding: var(--sp-sm) var(--sp-md);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-fg);
    cursor: pointer;
    background: none;
    border: 1px solid var(--c-border-strong);
    border-radius: 0;
    transition: 0.2s;
  }

  .form__submit:hover:not(:disabled) {
    color: var(--c-ink);
    background: var(--c-accent);
    border-color: var(--c-accent);
    box-shadow: var(--glow-accent);
    opacity: 1;
  }

  .form__submit:disabled {
    cursor: progress;
    opacity: 0.55;
  }

  /* WhatsApp es la vía inmediata: se distingue del envío sin robarle el
     acento rojo de la marca hasta que se pasa el ratón. */
  .form__whatsapp {
    color: var(--c-fg-muted);
    border-color: var(--c-border);
  }

  .form__whatsapp:hover {
    color: var(--c-fg);
    border-color: var(--c-border-strong);
    background: var(--c-bg-elevated);
  }

  .form__whatsapp-icon {
    width: 1.05rem;
    height: 1.05rem;
    color: #25d366;
  }

  .form__status:empty {
    display: none;
  }

  .form__status {
    font-size: var(--fs-sm);
    color: var(--c-fg-muted);
  }
</style>

<script>
  /**
   * Un solo script para todas las instancias del formulario: Astro publica el
   * bloque una vez por página, así que aquí se recorren todos los formularios
   * marcados en lugar de buscar un `id` concreto.
   */
  function initContactForms(): void {
    const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]')

    forms.forEach((form) => {
      if (form.dataset.bound === 'true') return
      form.dataset.bound = 'true'

      const status = form.querySelector<HTMLParagraphElement>('.form__status')
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')
      if (!status || !submit) return

      form.addEventListener('submit', async (event) => {
        event.preventDefault()

        // Validación nativa antes de tocar la red.
        if (!form.checkValidity()) {
          form.reportValidity()
          return
        }

        submit.disabled = true
        status.textContent = 'Enviando…'

        const entries = Object.fromEntries(new FormData(form).entries())
        // Los opcionales vacíos no viajan: el backend los valida si llegan.
        const data = Object.fromEntries(
          Object.entries(entries).filter(([, value]) => String(value).trim() !== ''),
        )

        try {
          const response = await fetch(`${form.dataset.api}/contact`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          })

          if (!response.ok) throw new Error(`HTTP ${response.status}`)

          form.reset()
          status.textContent = 'Mensaje enviado. Gracias por escribirnos.'
        } catch {
          status.textContent =
            'No se ha podido enviar el mensaje. Inténtalo de nuevo en unos minutos.'
        } finally {
          submit.disabled = false
        }
      })
    })
  }

  initContactForms()
  document.addEventListener('astro:after-swap', initContactForms)
</script>
