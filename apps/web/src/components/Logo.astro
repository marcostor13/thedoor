---
/** Wordmark de texto: THE • DOOR • PR, con los separadores como puntos rojos
 *  luminosos. Se usa en la nav y en el pie; el icono de la puerta vive en
 *  DoorMark.astro. */
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class={`wordmark ${className ?? ''}`}>
  THE<span class="wordmark__dot" aria-hidden="true"></span>DOOR<span
    class="wordmark__dot"
    aria-hidden="true"></span>PR
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-fg);
    white-space: nowrap;
  }

  .wordmark__dot {
    display: inline-block;
    /* Escalado con el texto: en el pie mide la mitad que en el hero sin
       necesidad de una variante por sitio de uso. */
    width: 0.3em;
    height: 0.3em;
    margin-inline: 0.5em;
    background: var(--c-accent);
    border-radius: 50%;
    box-shadow: var(--glow-sm);
  }
</style>
