---
/** Wordmark de texto: THE • DOOR • PR, con los separadores como puntos rojos
 *  luminosos. Se usa en la nav y en el pie; el icono de la puerta vive en
 *  DoorMark.astro. */
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class={`wordmark ${className ?? ''}`}>
  THE<span class="wordmark__dot" aria-hidden="true"></span>DOOR<span
    class="wordmark__dot"
    aria-hidden="true"></span>PR
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    line-height: 1;
    letter-spacing: var(--ls-widest);
    text-transform: uppercase;
    color: var(--c-fg);
    white-space: nowrap;
    /* El tracking ancho deja un hueco muerto al final de la caja: lo
       recortamos para que el lockup quede ópticamente centrado. */
    margin-inline-end: calc(var(--ls-widest) * -1);
  }

  /* Rombo en vez de punto: rima con la clave del arco de la marca. */
  .wordmark__dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-inline: 0.5em 0.44em;
    background: var(--c-accent);
    box-shadow: 0 0 9px var(--c-accent);
    transform: rotate(45deg);
  }
</style>
