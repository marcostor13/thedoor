---
import Logo from './Logo.astro'
import { NAV_LINKS, SITE } from '../data/navigation'
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__brand" href="/#top" aria-label={`${SITE.name} — inicio`}>
      <Logo />
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <ul role="list" class="header__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="header__link" href={link.href} data-nav-link>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__right">
      <div class="lang-toggle" role="group" aria-label="Idioma">
        <button type="button" class="lang-toggle__btn is-active" aria-pressed="true">ES</button>
        <span class="lang-toggle__sep" aria-hidden="true">/</span>
        <button type="button" class="lang-toggle__btn" aria-pressed="false">EN</button>
      </div>

      <a class="header__cta" href="/#apply">{SITE.cta} →</a>

      <button
        class="header__burger"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Abrir menú</span>
        <span class="header__burger-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<!-- Menú móvil. Vive fuera de <header> para que su posición fija no dependa del
     apilamiento de la cabecera ni de su `backdrop-filter`. -->
<div class="menu" id="site-menu" data-menu hidden>
  <nav class="menu__inner" aria-label="Navegación">
    <ul role="list" class="menu__list">
      {
        NAV_LINKS.map((link, index) => (
          <li style={`--i: ${index}`}>
            <a class="menu__link" href={link.href} data-menu-link>
              <span class="menu__num">{String(index + 1).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a class="menu__cta" href="/#apply" data-menu-link>{SITE.cta} →</a>
    <p class="menu__meta">{SITE.city}</p>
  </nav>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(0 0 0 / 0.6);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition:
      background var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  /* Al pie del hero la cabecera flota sin marco; en cuanto hay contenido detrás
     se apoya sobre una línea. Un borde permanente parte el hero en dos. */
  .header.is-scrolled {
    background: rgb(0 0 0 / 0.82);
    border-bottom-color: var(--c-border);
  }

  .header__inner {
    display: flex;
    gap: var(--sp-md);
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }

  .header__brand {
    display: block;
    text-decoration: none;
  }

  .header__nav {
    min-width: 0;
  }

  .header__list {
    display: flex;
    gap: clamp(var(--sp-sm), 2.5vw, 1.75rem);
    align-items: center;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .header__link {
    position: relative;
    display: block;
    padding-block: var(--sp-3xs);
    text-decoration: none;
    color: var(--c-fg);
    opacity: 0.7;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  /* Subrayado que crece desde el centro: el mismo gesto simétrico que abre la
     puerta, repetido a escala de detalle. */
  .header__link::after {
    content: '';
    position: absolute;
    inset-block-end: -2px;
    inset-inline: 0;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-xs);
    transform: scaleX(0);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__link:hover,
  .header__link.is-current {
    opacity: 1;
    color: var(--c-accent);
  }

  .header__link:hover::after,
  .header__link.is-current::after {
    transform: scaleX(1);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
  }

  .lang-toggle__btn {
    padding: 4px 2px;
    color: var(--c-fg-muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .lang-toggle__btn:hover {
    color: var(--c-fg);
  }

  .lang-toggle__btn.is-active {
    color: var(--c-accent);
    text-shadow: var(--text-glow-sm);
  }

  .lang-toggle__sep {
    color: var(--c-fg-faint);
  }

  .header__cta {
    position: relative;
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--c-fg);
    border: 1px solid var(--c-border-strong);
    overflow: hidden;
    /* Crea contexto de apilamiento propio: sin esto el relleno con z-index -1
       escaparía al de la cabecera y se pintaría bajo su fondo. */
    isolation: isolate;
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  /* El relleno del botón entra como una hoja de puerta: barrido desde el borde,
     no un cambio de color instantáneo. */
  .header__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__cta:hover {
    color: var(--c-accent-contrast);
    border-color: var(--c-accent);
    box-shadow: var(--glow-md);
  }

  .header__cta:hover::before {
    transform: scaleX(1);
  }

  /* --- Botón de menú -------------------------------------------------------- */

  .header__burger {
    display: none;
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    border: 1px solid var(--c-border-strong);
    cursor: pointer;
  }

  /* Dos barras hechas con el propio elemento y su pseudo: al abrir giran en
     sentidos opuestos sobre el mismo centro y forman la cruz. */
  .header__burger-bars,
  .header__burger-bars::after {
    position: absolute;
    inset-inline: 25%;
    height: 1px;
    background: var(--c-fg);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__burger-bars {
    inset-block-start: calc(50% - 4px);
  }

  .header__burger-bars::after {
    content: '';
    inset-inline: 0;
    inset-block-start: 8px;
  }

  .header__burger[aria-expanded='true'] .header__burger-bars {
    transform: translateY(4px) rotate(45deg);
  }

  .header__burger[aria-expanded='true'] .header__burger-bars::after {
    transform: translateY(-8px) rotate(-90deg);
  }

  /* --- Menú desplegable ----------------------------------------------------- */

  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    display: grid;
    align-content: center;
    background: rgb(0 0 0 / 0.96);
    backdrop-filter: blur(20px);
  }

  .menu[hidden] {
    display: none;
  }

  .menu__inner {
    padding-inline: var(--gutter);
  }

  .menu__list {
    display: grid;
    gap: var(--sp-xs);
    margin: 0;
  }

  .menu__list li {
    opacity: 0;
    transform: translateY(1rem);
    animation: menu-item-in 600ms var(--ease-cinematic) forwards;
    animation-delay: calc(120ms + var(--i, 0) * 70ms);
  }

  @keyframes menu-item-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--sp-md);
    padding-block: var(--sp-2xs);
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-fg);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .menu__link:hover {
    color: var(--c-accent);
    text-shadow: var(--text-glow-sm);
  }

  .menu__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    color: var(--c-accent);
  }

  .menu__cta {
    display: inline-block;
    margin-block-start: var(--sp-xl);
    padding: var(--sp-sm) var(--sp-md);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-fg);
    border: 1px solid var(--c-border-strong);
  }

  .menu__cta:hover {
    color: var(--c-accent-contrast);
    background: var(--c-accent);
    border-color: var(--c-accent);
    box-shadow: var(--glow-md);
  }

  .menu__meta {
    margin-block-start: var(--sp-lg);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-faint);
  }

  @media (max-width: 860px) {
    .header__nav {
      display: none;
    }

    .header__burger {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .header__cta,
    .lang-toggle {
      display: none;
    }
  }
</style>

<script>
  function initHeader(): void {
    const header = document.querySelector<HTMLElement>('[data-header]')
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')
    const menu = document.querySelector<HTMLElement>('[data-menu]')

    // --- Estado de la cabecera al hacer scroll ---
    if (header) {
      const sentinel = document.createElement('div')
      sentinel.setAttribute('aria-hidden', 'true')
      document.body.prepend(sentinel)

      // Un observador sobre un centinela de altura cero al principio del
      // documento: cuesta cero por fotograma, a diferencia de un listener de
      // scroll leyendo `scrollY`.
      new IntersectionObserver(
        ([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting),
        { threshold: 0 },
      ).observe(sentinel)
    }

    // --- Menú móvil ---
    if (toggle && menu) {
      const setOpen = (open: boolean): void => {
        toggle.setAttribute('aria-expanded', String(open))
        menu.hidden = !open
        document.body.style.overflow = open ? 'hidden' : ''
        if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus()
        else toggle.focus()
      }

      toggle.addEventListener('click', () =>
        setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
      )

      // Navegar dentro de la misma página no recarga nada, así que el menú
      // tiene que cerrarse a mano o taparía el destino.
      menu.querySelectorAll('[data-menu-link]').forEach((link) =>
        link.addEventListener('click', () => setOpen(false)),
      )

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menu.hidden) setOpen(false)
      })
    }

    // --- Sección activa ---
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')]
    const sections = links
      .map((link) => document.querySelector<HTMLElement>(`#${link.hash.slice(1)}`))
      .filter((section): section is HTMLElement => section !== null)

    if (sections.length > 0) {
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            const id = entry.target.id
            links.forEach((link) => link.classList.toggle('is-current', link.hash === `#${id}`))
          }
        },
        // La banda central del viewport decide qué sección está "en curso":
        // evita que dos secciones se disputen el marcado a la vez.
        { rootMargin: '-45% 0px -45% 0px' },
      )

      sections.forEach((section) => spy.observe(section))
    }
  }

  initHeader()
  document.addEventListener('astro:after-swap', initHeader)
</script>
