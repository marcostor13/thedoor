---
import Logo from './Logo.astro'
import DoorGlyph from './DoorGlyph.astro'
import { NAV_LINKS, SITE } from '../data/navigation'
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/#top" aria-label={`${SITE.name} — inicio`}>
      <DoorGlyph class="header__glyph" id="header" />
      <span class="header__rule" aria-hidden="true"></span>
      <span class="header__brand-text">
        <Logo class="header__wordmark" />
        <span class="header__kicker">PR House — Lima</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <ul role="list" class="header__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a class="header__link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__right">
      <div class="lang-toggle" role="group" aria-label="Idioma">
        <button type="button" class="lang-toggle__btn is-active" aria-pressed="true">ES</button>
        <span class="lang-toggle__sep" aria-hidden="true">/</span>
        <button type="button" class="lang-toggle__btn" aria-pressed="false">EN</button>
      </div>

      <a class="header__cta" href="/registro/">{SITE.cta} →</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(0 0 0 / 0.75);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
  }

  .header__inner {
    display: flex;
    gap: var(--sp-md);
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
  }

  /* Lockup: glifo · filete · wordmark sobre kicker. El filete alinea las dos
     mitades y le da al conjunto el aire editorial del resto del sitio. */
  .header__brand {
    display: inline-flex;
    flex-shrink: 0;
    gap: 0.625rem;
    align-items: center;
    text-decoration: none;
  }

  /* El glifo se mide contra la altura de la caja de texto del lockup, no
     contra la cabecera: a 2.25rem competía con el wordmark en vez de
     acompañarlo. */
  :global(.header__glyph) {
    width: auto;
    height: 1.6rem;
  }

  .header__rule {
    width: 1px;
    height: 1.4rem;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--c-border-strong) 25%,
      var(--c-border-strong) 75%,
      transparent
    );
  }

  .header__brand-text {
    display: grid;
    gap: 4px;
  }

  :global(.header__wordmark) {
    font-size: var(--fs-lg);
    line-height: 1;
  }

  .header__kicker {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1;
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  @media (max-width: 420px) {
    .header__rule,
    .header__kicker {
      display: none;
    }
  }

  .header__nav {
    min-width: 0;
  }

  .header__list {
    display: flex;
    gap: clamp(var(--sp-sm), 2.5vw, 1.75rem);
    align-items: center;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
  }

  .header__link {
    text-decoration: none;
    color: var(--c-fg);
    opacity: 0.72;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .header__link:hover {
    opacity: 1;
    color: var(--c-accent);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: var(--sp-md);
  }

  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
  }

  .lang-toggle__btn {
    padding: 4px 2px;
    color: var(--c-fg-muted);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .lang-toggle__btn:hover {
    color: var(--c-fg);
  }

  .lang-toggle__btn.is-active {
    color: var(--c-accent);
    text-shadow: 0 0 12px var(--c-accent);
  }

  .lang-toggle__sep {
    color: var(--c-fg-muted);
  }

  .header__cta {
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: var(--c-fg);
    border: 1px solid var(--c-border-strong);
    transition: 0.2s;
  }

  .header__cta:hover {
    color: var(--c-ink);
    background: var(--c-accent);
    border-color: var(--c-accent);
    box-shadow: var(--glow-accent);
  }

  @media (max-width: 860px) {
    .header__nav {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .header__cta {
      display: none;
    }
  }
</style>
