---
import Logo from './Logo.astro'
import { NAV_LINKS } from '../data/navigation'
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/" aria-label="The Door — inicio">
      <Logo class="header__logo" />
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <ul role="list" class="header__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                class="header__link"
                href={link.href}
                aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: color-mix(in srgb, var(--c-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
  }

  .header__inner {
    display: flex;
    gap: var(--sp-md);
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
  }

  .header__brand {
    display: block;
    text-decoration: none;
  }

  .header__logo {
    width: 8.75rem;
  }

  .header__list {
    display: flex;
    gap: clamp(var(--sp-sm), 2.5vw, var(--sp-lg));
    align-items: center;
    margin: 0;
  }

  .header__link {
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-fg-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .header__link:hover,
  .header__link[aria-current='page'] {
    color: var(--c-fg);
  }

  /* En móvil la navegación no se oculta: se deja desplazable en horizontal,
     para no dejar el sitio sin navegación mientras no exista un menú
     hamburguesa. Ese menú se decidirá con el inventario de contenido delante,
     cuando se sepa cuántas secciones hay realmente. */
  @media (max-width: 768px) {
    .header__inner {
      gap: var(--sp-sm);
    }

    .header__logo {
      width: 6.5rem;
    }

    .header__nav {
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .header__nav::-webkit-scrollbar {
      display: none;
    }

    .header__list {
      gap: var(--sp-sm);
    }

    .header__link {
      white-space: nowrap;
      font-size: var(--fs-xs);
    }
  }
</style>
