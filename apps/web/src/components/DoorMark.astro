<style>
  .doormark {
    overflow: visible;
    /* Apertura de reposo. En el logo la puerta está casi cerrada: lo único
       que la cruza es una rendija de luz, y esa rendija ES la marca. Con la
       hoja al 50 % el hueco se abría tanto que la pieza dejaba de leerse como
       una puerta cerrada con luz detrás y pasaba a ser un portal abierto. */
    --leaf: 0.94;

    /* -----------------------------------------------------------------------
       GROSORES — el carácter de la marca vive aquí.

       La marca es un rótulo de neón, y un tubo de neón es grueso: la marca
       pequeña (DoorGlyph, favicon) siempre lo fue —su arco exterior pesa un
       4 % del ancho— pero esta grande se había quedado en un 0,46 %, nueve
       veces más fina, y a tamaño de hero se leía como un plano técnico en vez
       de como un letrero encendido.

       El equilibrio es delicado: demasiado fino y deja de ser un letrero;
       demasiado grueso y el tubo se come la ornamentación —cresta, capiteles,
       rosetones—, que es justo lo que hace reconocible a la marca. Los
       maestros pesan, el ornamento dibuja.

       Todos los trazos se miden contra el viewBox de 240, y van juntos: si se
       sube uno hay que subir el resto o la jerarquía se rompe. Por eso están
       aquí y no repartidos en cuarenta atributos del markup.
       -------------------------------------------------------------------- */
    --dm-w-arch: 3;
    --dm-w-arch-mid: 2;
    --dm-w-arch-in: 2.6;
    --dm-w-col: 2.6;
    --dm-w-sill: 3;
    --dm-w-leaf: 2.6;
    --dm-w-panel: 1.8;
    --dm-w-panel-in: 1.2;
    --dm-w-orn: 1.7;
    --dm-w-detail: 1.4;
    --dm-w-hair: 1;
  }

  .dm-w-arch { stroke-width: var(--dm-w-arch); }
  .dm-w-arch-mid { stroke-width: var(--dm-w-arch-mid); }
  .dm-w-arch-in { stroke-width: var(--dm-w-arch-in); }
  .dm-w-col { stroke-width: var(--dm-w-col); }
  .dm-w-sill { stroke-width: var(--dm-w-sill); }
  .dm-w-leaf { stroke-width: var(--dm-w-leaf); }
  .dm-w-panel { stroke-width: var(--dm-w-panel); }
  .dm-w-panel-in { stroke-width: var(--dm-w-panel-in); }
  .dm-w-orn { stroke-width: var(--dm-w-orn); }
  .dm-w-detail { stroke-width: var(--dm-w-detail); }
  .dm-w-hair { stroke-width: var(--dm-w-hair); }

  /* =========================================================================
     HAZ PROYECTADO — la luz que cruza el umbral
     ====================================================================== */

  /* Se mide en scaleX desde la boca de la puerta: el haz es tan ancho como el
     hueco que lo deja pasar, así que abrir la puerta y ensanchar el haz son
     el mismo gesto. `--cast` acompaña a `--leaf`. */
  .dm-cast {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    transform: scaleX(var(--cast, 0.5));
    opacity: var(--cast-lit, 0.45);
    will-change: transform, opacity;
  }

  /* =========================================================================
     HOJAS — tres capas que se multiplican (ver cabecera del componente)
     ====================================================================== */

  .door-leaf,
  .door-leaf__swing,
  .door-leaf__sway {
    transform-box: fill-box;
  }

  .door-leaf--left,
  .door-leaf--left .door-leaf__swing,
  .door-leaf--left .door-leaf__sway {
    transform-origin: 0% 50%;
  }

  .door-leaf--right,
  .door-leaf--right .door-leaf__swing,
  .door-leaf--right .door-leaf__sway {
    transform-origin: 100% 50%;
  }

  .door-leaf {
    transform: scaleX(var(--leaf));
  }

  /* =========================================================================
     BUCLE AMBIENTAL — la marca nunca está del todo quieta
     ====================================================================== */

  .door-leaf__sway {
    will-change: transform;
    animation: dm-sway 13s var(--ease-in-out) infinite;
  }

  /* La hoja derecha va medio compás por detrás: al unísono parecen un
     acordeón; desfasadas parecen una corriente de aire. */
  .door-leaf--right .door-leaf__sway {
    animation-delay: -4.5s;
  }

  .dm-halo {
    transform-origin: 120px 190px;
    animation: dm-breathe 7s var(--ease-in-out) infinite;
  }

  .dm-inside {
    animation: dm-inside-breathe 13s var(--ease-in-out) infinite;
  }

  .dm-sweep {
    animation: dm-sweep 6.5s var(--ease-in-out) infinite;
  }

  .dm-mote {
    animation: dm-mote 9s linear infinite;
  }

  .dm-mote:nth-child(2) {
    animation-duration: 12s;
    animation-delay: -2.5s;
  }

  .dm-mote:nth-child(3) {
    animation-name: dm-mote-drift;
    animation-duration: 10.5s;
    animation-delay: -6s;
  }

  .dm-mote:nth-child(4) {
    animation-duration: 13.5s;
    animation-delay: -9s;
  }

  .dm-mote:nth-child(5) {
    animation-name: dm-mote-drift;
    animation-duration: 11s;
    animation-delay: -4s;
  }

  .dm-mote:nth-child(6) {
    animation-duration: 15s;
    animation-delay: -12s;
  }

  .dm-rays {
    transform-origin: 120px 205px;
    opacity: 0.62;
    animation: dm-rays-breathe 11s var(--ease-in-out) infinite;
  }

  .dm-seam {
    animation: dm-flicker 9s linear infinite;
  }

  /* En reposo el quicio ya no es una rendija sino la columna de luz que
     ocupa el hueco entreabierto; la entrada la abre desde la cuchilla. */
  .dm-blade {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleX(var(--seam, 6));
  }

  /* Zumbido de neón: la carpintería duda un instante de vez en cuando. */
  .dm-frame {
    animation: dm-neon 8s linear infinite;
  }

  .dm-star {
    transform-origin: 120px 16px;
    animation: dm-star-pulse 5s var(--ease-in-out) infinite;
  }

  .dm-pool,
  .dm-threshold {
    animation: dm-inside-breathe 13s var(--ease-in-out) infinite;
  }

  @keyframes dm-sway {
    0%,
    100% {
      transform: scaleX(1);
    }
    38% {
      transform: scaleX(0.972);
    }
    64% {
      transform: scaleX(0.988);
    }
  }

  @keyframes dm-breathe {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.055);
    }
  }

  /* Mismo perfil que dm-sway: el pico de luz cae donde la puerta está más
     abierta. */
  @keyframes dm-inside-breathe {
    0%,
    100% {
      opacity: 0.8;
    }
    38% {
      opacity: 1;
    }
    64% {
      opacity: 0.9;
    }
  }

  @keyframes dm-sweep {
    0% {
      opacity: 0;
      transform: translateY(30px);
    }
    18% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-262px);
    }
  }

  @keyframes dm-mote {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    12% {
      opacity: 0.7;
    }
    78% {
      opacity: 0.45;
    }
    100% {
      opacity: 0;
      transform: translateY(-224px);
    }
  }

  @keyframes dm-mote-drift {
    0% {
      opacity: 0;
      transform: translate(0, 0);
    }
    12% {
      opacity: 0.65;
    }
    50% {
      transform: translate(-7px, -112px);
    }
    78% {
      opacity: 0.4;
    }
    100% {
      opacity: 0;
      transform: translate(4px, -224px);
    }
  }

  @keyframes dm-rays-breathe {
    0%,
    100% {
      opacity: 0.42;
      transform: rotate(-1.5deg) scale(1);
    }
    50% {
      opacity: 0.72;
      transform: rotate(1.5deg) scale(1.05);
    }
  }

  @keyframes dm-star-pulse {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @keyframes dm-flicker {
    0%,
    46%,
    49.5%,
    52%,
    88%,
    91%,
    100% {
      opacity: 1;
    }
    48% {
      opacity: 0.72;
    }
    50.5% {
      opacity: 0.88;
    }
    89.5% {
      opacity: 0.66;
    }
  }

  @keyframes dm-neon {
    0%,
    61%,
    64.5%,
    69%,
    72%,
    100% {
      opacity: 1;
    }
    62.5% {
      opacity: 0.5;
    }
    67% {
      opacity: 0.78;
    }
    70.5% {
      opacity: 0.62;
    }
  }

  /* =========================================================================
     ENTRADA — la marca `staged` nace invisible y espera a scripts/door.ts
     ====================================================================== */

  /* Solo con JS: sin él la puerta está ahí desde el primer pintado. */
  :global(html.js) .doormark--staged {
    opacity: 0;
  }

  .dm-halo-in {
    transform-origin: 120px 190px;
  }

  .dm-star-in {
    transform-origin: 120px 16px;
  }

  .dm-rays-in {
    transform-origin: 120px 205px;
  }

  .doormark--staged.dm-enter,
  .doormark--staged.dm-settle {
    animation: dm-mark-in 600ms var(--ease-out) both;
  }

  /* --- Apertura completa: no hubo intro que la contara --------------------
     Cuatro actos, ~4,8 s. Los tiempos están escritos para leerse como partitura:
       0,0 – 2,0 s  SE DIBUJA   la carpintería aparece trazo a trazo
       1,7 – 2,9 s  PRENDE      la luz de encima y una cuchilla en el quicio
       2,3 – 3,0 s  LLAMA       dos golpes: la puerta se anuncia antes de abrirse
       2,8 – 4,4 s  ABRE        las hojas giran y la luz inunda por etapas
       4,4 – 4,8 s  ASIENTA     el vaivén y el zumbido toman el relevo
     ---------------------------------------------------------------------- */

  /* Movimiento de conjunto: entra ligeramente sobredimensionada y se asienta,
     con dos golpes secos en medio — la marca «llama a la puerta» antes de
     abrirla. Opacidad y transform son animaciones distintas y no se pisan. */
  .doormark--staged.dm-enter {
    animation:
      dm-mark-in 800ms var(--ease-out) both,
      dm-entrance-move 4800ms var(--ease-out) both;
  }

  .doormark--staged.dm-enter .dm-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: dm-draw-on 1400ms var(--ease-in-out) 200ms forwards;
  }

  /* La basa se dibuja después que el resto: el trazo baja por la columna y
     asienta al llegar al suelo, en vez de aparecer toda la pieza a la vez. */
  .doormark--staged.dm-enter .dm-w-orn .dm-draw,
  .doormark--staged.dm-enter .dm-draw.dm-w-sill {
    animation-delay: 900ms;
    animation-duration: 1000ms;
  }

  /* El neón gana cuerpo a medida que el trazo se completa, y al terminar cede
     el testigo al zumbido ambiental — que si no, quedaría anulado por esta
     misma declaración. */
  .doormark--staged.dm-enter .dm-frame {
    animation:
      dm-frame-charge 1900ms var(--ease-out) 200ms both,
      dm-neon 8s linear 4700ms infinite;
  }

  .doormark--staged.dm-enter .dm-hinges {
    animation: dm-mark-in 700ms var(--ease-out) 1400ms both;
  }

  .doormark--staged.dm-enter .dm-halo-in {
    animation: dm-halo-in 2400ms var(--ease-out) 150ms both;
  }

  .doormark--staged.dm-enter .dm-star-in {
    animation: dm-star-in 1000ms var(--ease-out) 1750ms both;
  }

  .doormark--staged.dm-enter .dm-blade {
    animation:
      dm-blade-in 2000ms var(--ease-door) 1900ms both,
      dm-blade-knock 900ms var(--ease-in-out) 2300ms;
  }

  .doormark--staged.dm-enter .door-leaf__swing {
    animation: dm-swing-open 1600ms var(--ease-door) 2800ms both;
  }

  .doormark--staged.dm-enter .dm-inside-in {
    animation: dm-inside-in 1500ms var(--ease-out) 2850ms both;
  }

  .doormark--staged.dm-enter .dm-rays-in {
    animation: dm-rays-in 1600ms var(--ease-out) 3200ms both;
  }

  /* El haz entra con la apertura, no antes: mientras las hojas están cerradas
     no hay hueco por el que salga nada. */
  .doormark--staged .dm-cast-in {
    opacity: 0;
  }

  .doormark--staged.dm-enter .dm-cast-in,
  .doormark--staged.dm-settle .dm-cast-in,
  .doormark--staged.dm-opened .dm-cast-in {
    animation: dm-cast-in 1400ms var(--ease-out) 900ms both;
  }

  .doormark--staged.dm-enter .dm-spill {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: dm-spill-in 1400ms var(--ease-out) 3350ms both;
  }

  /* El vaivén y el zumbido esperan a que la puerta llegue a su sitio: si no,
     ensucian el gesto de apertura. */
  .doormark--staged.dm-enter .door-leaf__sway,
  .doormark--staged.dm-enter .door-leaf--right .door-leaf__sway {
    animation-delay: 4600ms;
  }

  /* --- Solo asentarse: el intro ya enseñó la apertura --------------------- */

  .doormark--staged.dm-settle .door-leaf__swing {
    animation: dm-swing-settle 1100ms var(--ease-out) 100ms both;
  }

  .doormark--staged.dm-settle .dm-inside-in {
    animation: dm-inside-settle 1100ms var(--ease-out) both;
  }

  .doormark--staged.dm-settle .dm-halo-in {
    animation: dm-halo-in 1200ms var(--ease-out) both;
  }

  .doormark--staged.dm-settle .dm-rays-in {
    animation: dm-rays-in 1400ms var(--ease-out) 200ms both;
  }

  .doormark--staged.dm-settle .dm-spill {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: dm-spill-in 1000ms var(--ease-out) 150ms both;
  }

  .doormark--staged.dm-settle .door-leaf__sway,
  .doormark--staged.dm-settle .door-leaf--right .door-leaf__sway {
    animation-delay: 1200ms;
  }

  /* --- Puerta abierta de par en par --------------------------------------
     Estado que se pide desde fuera (`dm-opened`) cuando alguien acaba de
     entrar: es la recompensa del registro. Va después de dm-enter/dm-settle
     a propósito — misma especificidad, gana el orden de aparición.
     ---------------------------------------------------------------------- */

  .doormark--staged.dm-opened .door-leaf__swing {
    animation: dm-swing-wide 1600ms var(--ease-door) both;
  }

  /* Con la puerta abierta ya no hay corriente que la mueva: se queda quieta
     y quien respira es la luz. */
  .doormark--staged.dm-opened .door-leaf__sway,
  .doormark--staged.dm-opened .door-leaf--right .door-leaf__sway {
    animation: none;
  }

  .doormark--staged.dm-opened .dm-blade {
    animation: dm-blade-wide 1600ms var(--ease-out) both;
  }

  .doormark--staged.dm-opened .dm-inside-in {
    animation: dm-flood 1600ms var(--ease-out) both;
  }

  .doormark--staged.dm-opened .dm-rays-in {
    animation: dm-rays-wide 1800ms var(--ease-out) both;
  }

  .doormark--staged.dm-opened .dm-spill {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    animation: dm-spill-wide 1600ms var(--ease-out) 120ms both;
  }

  /* La recompensa: el hueco se abre entero y la luz sale de golpe. Va con el
     mismo retardo que el giro de las hojas, para que se lea como una sola
     cosa —la puerta abriéndose— y no como dos animaciones a la vez. */
  .doormark--staged.dm-opened .dm-cast {
    animation: dm-cast-wide 1700ms var(--ease-out) 140ms both;
  }

  @keyframes dm-cast-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dm-cast-wide {
    0% {
      transform: scaleX(0.5);
      opacity: 0.45;
    }
    52% {
      transform: scaleX(1.06);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0.92;
    }
  }

  @keyframes dm-swing-wide {
    0% {
      transform: scaleX(1);
      filter: brightness(1);
    }
    58% {
      transform: scaleX(0.22);
      filter: brightness(1.5);
    }
    100% {
      transform: scaleX(0.3);
      filter: brightness(1.15);
    }
  }

  @keyframes dm-blade-wide {
    from {
      transform: scaleX(6);
    }
    to {
      transform: scaleX(16);
    }
  }

  @keyframes dm-flood {
    0% {
      filter: brightness(1) saturate(1);
    }
    50% {
      filter: brightness(1.55) saturate(1.15);
    }
    100% {
      filter: brightness(1.2) saturate(1);
    }
  }

  @keyframes dm-rays-wide {
    to {
      transform: scale(1.18);
    }
  }

  @keyframes dm-spill-wide {
    to {
      transform: scaleX(1.35);
    }
  }

  /* Sobredimensión que se asienta, con dos golpes antes de abrir. */
  @keyframes dm-entrance-move {
    0% {
      transform: scale(1.035);
    }
    46% {
      transform: scale(1.014);
    }
    50% {
      transform: scale(1.026);
    }
    54% {
      transform: scale(1.012);
    }
    58% {
      transform: scale(1.022);
    }
    62% {
      transform: scale(1.009);
    }
    100% {
      transform: scale(1);
    }
  }

  /* El tubo de neón cogiendo carga mientras se dibuja. */
  @keyframes dm-frame-charge {
    0% {
      opacity: 0.45;
      filter: brightness(0.5);
    }
    70% {
      opacity: 1;
      filter: brightness(1.35);
    }
    100% {
      opacity: 1;
      filter: brightness(1);
    }
  }

  /* Los dos golpes, vistos desde la rendija de luz. */
  @keyframes dm-blade-knock {
    0%,
    100% {
      filter: brightness(1);
    }
    18% {
      filter: brightness(2.1);
    }
    34% {
      filter: brightness(0.9);
    }
    52% {
      filter: brightness(1.9);
    }
    70% {
      filter: brightness(1);
    }
  }

  @keyframes dm-mark-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dm-draw-on {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes dm-halo-in {
    0% {
      opacity: 0;
      transform: scale(0.8);
    }
    70% {
      opacity: 1;
      transform: scale(1.05);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dm-star-in {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    60% {
      opacity: 1;
      transform: scale(1.3);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dm-blade-in {
    0% {
      opacity: 0;
      transform: scaleX(0.15) scaleY(0.28);
    }
    14% {
      opacity: 1;
      transform: scaleX(0.45) scaleY(1);
    }
    /* Se queda fina mientras suenan los golpes: la puerta aún no cede. */
    45% {
      transform: scaleX(0.5) scaleY(1);
    }
    72% {
      transform: scaleX(2.2) scaleY(1);
    }
    100% {
      opacity: 1;
      transform: scaleX(6) scaleY(1);
    }
  }

  /* La hoja gira desde cerrada (×2 sobre la apertura base), pasa un punto de
     la marca y vuelve, mientras su cara interior recibe la luz. */
  @keyframes dm-swing-open {
    0% {
      transform: scaleX(2);
      filter: brightness(0.32) saturate(0.65);
    }
    35% {
      filter: brightness(0.9) saturate(1);
    }
    68% {
      transform: scaleX(0.82);
      filter: brightness(1.32);
    }
    100% {
      transform: scaleX(1);
      filter: brightness(1);
    }
  }

  @keyframes dm-swing-settle {
    0% {
      transform: scaleX(0.84);
      filter: brightness(1.3);
    }
    100% {
      transform: scaleX(1);
      filter: brightness(1);
    }
  }

  @keyframes dm-inside-in {
    0% {
      opacity: 0;
      filter: brightness(0.15) saturate(1.4);
    }
    55% {
      opacity: 1;
      filter: brightness(1.45) saturate(1.4);
    }
    100% {
      opacity: 1;
      filter: brightness(1) saturate(1);
    }
  }

  @keyframes dm-inside-settle {
    0% {
      filter: brightness(1.55) saturate(1.35);
    }
    100% {
      filter: brightness(1) saturate(1);
    }
  }

  @keyframes dm-rays-in {
    0% {
      opacity: 0;
      transform: scale(0.35);
    }
    45% {
      opacity: 1;
