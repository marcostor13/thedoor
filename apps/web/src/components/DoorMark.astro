    }
    55% {
      opacity: 1;
      filter: brightness(1.45) saturate(1.4);
    }
    100% {
      opacity: 1;
      filter: brightness(1) saturate(1);
    }
  }

  @keyframes dm-inside-settle {
    0% {
      filter: brightness(1.55) saturate(1.35);
    }
    100% {
      filter: brightness(1) saturate(1);
    }
  }

  @keyframes dm-rays-in {
    0% {
      opacity: 0;
      transform: scale(0.35);
    }
    45% {
      opacity: 1;
      transform: scale(1.1);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes dm-spill-in {
    0% {
      opacity: 0;
      transform: scaleX(0.12);
    }
    60% {
      opacity: 1;
      transform: scaleX(1.08);
    }
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .doormark--staged {
      opacity: 1;
    }

    .doormark,
    .doormark * {
      animation: none !important;
    }

    /* El haz nace invisible y lo enciende una animación. Sin animaciones esa
       regla no se levanta nunca y la puerta se queda sin luz: aquí se le da
       el estado final a mano. Quien pide menos movimiento pide eso, no
       perderse la mitad de la marca. */
    .doormark--staged .dm-cast-in {
      opacity: 1;
    }
  }
</style>
