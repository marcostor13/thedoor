---
/**
 * Marca de la puerta — el icono que preside el hero y protagoniza la
 * animación de entrada.
 *
 * Anatomía (viewBox 240 × 340):
 *   · Jamba de tres trazos + arco de medio punto sobre la línea de imposta.
 *   · Montante en abanico (fanlight) con radios y rosetón: es la pieza que
 *     más luz derrama, porque queda siempre por encima de las hojas.
 *   · Dos hojas macizas con relleno oscuro — ocultan el interior encendido
 *     y por eso la apertura se lee de verdad.
 *   · Sistema de luz: halo ambiental, foco interior, barrido, motas de polvo,
 *     rayos volumétricos, columna del quicio y derrame sobre el suelo.
 *
 * MOVIMIENTO — cada hoja es un sándwich de tres grupos que se multiplican,
 * para que las tres capas de animación no se peleen por `transform`:
 *
 *   .door-leaf           apertura base   scaleX(--leaf) = 0.5 (entreabierta)
 *   └ .door-leaf__swing  entrada         2 → 1  (de cerrada a su sitio)
 *     └ .door-leaf__sway vaivén eterno   1 ↔ 0.84
 *
 * El mismo truco con los envoltorios `*-in`: el bucle ambiental vive en el
 * elemento interior y la entrada en el envoltorio, así ninguna de las dos
 * tiene que reescribir a la otra.
 *
 * Con `staged` la marca nace invisible y espera a que le pongan `dm-enter`
 * (apertura completa) o `dm-settle` (solo asentarse, cuando la secuencia de
 * Intro.astro ya ha contado la apertura). De eso se encarga scripts/door.ts.
 */
interface Props {
  class?: string
  id?: string
  /** La entrada la dispara JS en vez de ocurrir al pintar. */
  staged?: boolean
  /**
   * `auto`  — apertura completa solo si no ha habido intro que la contara.
   * `full`  — apertura completa siempre; para páginas donde la puerta ES el
   *           contenido y no puede limitarse a asentarse.
   */
  entrance?: 'auto' | 'full'
}

const { class: className, id = 'r1', staged = false, entrance = 'auto' } = Astro.props

const motes = [
  { cx: 95, r: 1.2 },
  { cx: 103, r: 0.9 },
  { cx: 141, r: 1.3 },
  { cx: 148, r: 1 },
  { cx: 99, r: 1.1 },
  { cx: 145, r: 0.9 },
]
---

<svg
  class={`doormark ${staged ? 'doormark--staged' : ''} ${className ?? ''}`}
  data-door-entrance={staged ? entrance : undefined}
  viewBox="0 0 240 340"
  role="img"
  aria-label="The Door PR"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <filter id={`dm-hot-${id}`} x="-70%" y="-70%" width="240%" height="240%">
      <feGaussianBlur stdDeviation="3" result="b1"></feGaussianBlur>
      <feGaussianBlur stdDeviation="10" result="b2"></feGaussianBlur>
      <feGaussianBlur stdDeviation="24" result="b3"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b3"></feMergeNode>
        <feMergeNode in="b2"></feMergeNode>
        <feMergeNode in="b1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>

    <!-- La rendija tiene que brillar mucho y ocupar poco: con el resplandor
         general (blurs de 3/10/24) una línea de dos píxeles se convertía en
         una columna de luz que se comía la puerta entera. -->
    <filter id={`dm-seam-glow-${id}`} x="-900%" y="-40%" width="1900%" height="180%">
      <feGaussianBlur stdDeviation="1.4" result="b1"></feGaussianBlur>
      <feGaussianBlur stdDeviation="5" result="b2"></feGaussianBlur>
      <feGaussianBlur stdDeviation="13" result="b3"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b3"></feMergeNode>
        <feMergeNode in="b2"></feMergeNode>
        <feMergeNode in="b1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>

    <filter id={`dm-haze-${id}`} x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="9"></feGaussianBlur>
    </filter>

    <filter id={`dm-cast-blur-${id}`} x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="4.5"></feGaussianBlur>
    </filter>

    <!--
      NEÓN — lo que convierte una línea roja en un tubo encendido.

      Un trazo plano con un blur alrededor parece una línea con sombra. Un tubo
      real tiene tres cosas a la vez, y aquí se montan en este orden: un halo de
      color derramado en el aire (tres pasadas de blur, de cerca a lejos), el
      propio trazo, y —la que de verdad lo delata— un núcleo más claro y
      estrecho por dentro del trazo.

      Ese núcleo no se dibuja aparte: `feMorphology` adelgaza la silueta del
      propio trazo y se tiñe de blanco caliente. Así sale gratis para toda la
      carpintería, sin duplicar un solo path, y escala solo con el grosor — en
      los filetes finos la erosión se los come enteros y se quedan sin núcleo,
      que es justo lo que se quiere: la ornamentación no son tubos, es dibujo.
    -->
    <filter id={`dm-neon-${id}`} x="-50%" y="-50%" width="200%" height="200%">
      <feFlood flood-color="#ff1a25" result="tint"></feFlood>
      <feComposite in="tint" in2="SourceAlpha" operator="in" result="glow"></feComposite>

      <feGaussianBlur in="glow" stdDeviation="1.4" result="near"></feGaussianBlur>
      <feGaussianBlur in="glow" stdDeviation="4.5" result="mid"></feGaussianBlur>
      <feGaussianBlur in="glow" stdDeviation="12" result="far"></feGaussianBlur>

      <feMorphology in="SourceAlpha" operator="erode" radius="0.7" result="thin"></feMorphology>
      <feFlood flood-color="#fff4f0" result="hot"></feFlood>
      <feComposite in="hot" in2="thin" operator="in" result="core"></feComposite>
      <feGaussianBlur in="core" stdDeviation="0.4" result="coreSoft"></feGaussianBlur>

      <feMerge>
        <feMergeNode in="far"></feMergeNode>
        <feMergeNode in="far"></feMergeNode>
        <feMergeNode in="mid"></feMergeNode>
        <feMergeNode in="mid"></feMergeNode>
        <feMergeNode in="near"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
        <feMergeNode in="coreSoft"></feMergeNode>
      </feMerge>
    </filter>

    <!-- Aire encendido detrás de toda la pieza. -->
    <radialGradient id={`dm-halo-${id}`} cx="0.5" cy="0.56" r="0.5">
      <stop offset="0" stop-color="#ff2b36" stop-opacity="0.5"></stop>
      <stop offset="0.45" stop-color="#c00d18" stop-opacity="0.18"></stop>
      <stop offset="1" stop-color="#000000" stop-opacity="0"></stop>
    </radialGradient>

    <!-- Lo que hay al otro lado: blanco al rojo. -->
    <radialGradient id={`dm-inner-${id}`} cx="0.5" cy="0.62" r="0.6">
      <stop offset="0" stop-color="#fff6f0" stop-opacity="0.95"></stop>
      <stop offset="0.22" stop-color="#ff8a72" stop-opacity="0.78"></stop>
      <stop offset="0.55" stop-color="#ff1a25" stop-opacity="0.4"></stop>
      <stop offset="1" stop-color="#3d0206" stop-opacity="0.12"></stop>
    </radialGradient>

    <linearGradient id={`dm-sweep-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff2ec" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#fff2ec" stop-opacity="0.4"></stop>
      <stop offset="1" stop-color="#fff2ec" stop-opacity="0"></stop>
    </linearGradient>

    <!-- Hoja: canto interior tocado por la luz, resto en penumbra. -->
    <linearGradient id={`dm-leaf-l-${id}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#000000"></stop>
      <stop offset="0.62" stop-color="#0b0507"></stop>
      <stop offset="1" stop-color="#2a0a0d"></stop>
    </linearGradient>

    <!--
      LA RENDIJA. En el logo es la pieza protagonista: una franja vertical
      blanca al rojo entre las dos hojas, más brillante que ninguna otra cosa
      del dibujo. Todo lo demás es carpintería alrededor de esto.
    -->
    <linearGradient id={`dm-seam-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff2030" stop-opacity="0.12"></stop>
      <stop offset="0.2" stop-color="#ffdcd6" stop-opacity="0.85"></stop>
      <stop offset="0.55" stop-color="#fff4f1" stop-opacity="0.96"></stop>
      <stop offset="0.88" stop-color="#ff7078" stop-opacity="0.85"></stop>
      <stop offset="1" stop-color="#ff2030" stop-opacity="0.2"></stop>
    </linearGradient>

    <linearGradient id={`dm-beam-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff2ec" stop-opacity="0.7"></stop>
      <stop offset="0.35" stop-color="#ff5560" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </linearGradient>

    <linearGradient
      id={`dm-ray-${id}`}
      gradientUnits="userSpaceOnUse"
      x1="120"
      y1="190"
      x2="120"
      y2="-70"
    >
      <stop offset="0" stop-color="#ffd9d2" stop-opacity="0.45"></stop>
      <stop offset="0.4" stop-color="#ff4d58" stop-opacity="0.12"></stop>
      <stop offset="0.72" stop-color="#ff1a25" stop-opacity="0"></stop>
    </linearGradient>

    <!-- Luz que cruza el vano y se proyecta hacia fuera. -->
    <linearGradient id={`dm-cast-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6f2" stop-opacity="0.78"></stop>
      <stop offset="0.22" stop-color="#ff8478" stop-opacity="0.46"></stop>
      <stop offset="0.58" stop-color="#ff2a35" stop-opacity="0.19"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </linearGradient>

    <radialGradient id={`dm-floor-${id}`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffece6" stop-opacity="0.8"></stop>
      <stop offset="0.4" stop-color="#ff1a25" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </radialGradient>

    <clipPath id={`dm-bounds-${id}`}>
      <rect x="-70" y="-50" width="380" height="450"></rect>
    </clipPath>

    <!-- Silueta del vano: arco peraltado sobre las jambas. -->
    <clipPath id={`dm-clip-${id}`}>
      <path d="M 76 300 L 76 100 A 44 52 0 0 1 164 100 L 164 300 Z"></path>
    </clipPath>
  </defs>

  <!-- 1 · Aire ------------------------------------------------------------ -->
  <g class="dm-halo-in">
    <ellipse class="dm-halo" cx="120" cy="180" rx="132" ry="176" fill={`url(#dm-halo-${id})`}
    ></ellipse>
  </g>

  <!-- 2 · Lo que hay detrás de la puerta ---------------------------------- -->
  <g class="dm-inside-in">
    <g class="dm-inside" clip-path={`url(#dm-clip-${id})`}>
      <rect x="76" y="44" width="88" height="256" fill={`url(#dm-inner-${id})`}></rect>

      <!-- Una onda de luz sube por el hueco cada pocos segundos. -->
      <rect class="dm-sweep" x="76" y="250" width="88" height="56" fill={`url(#dm-sweep-${id})`}
      ></rect>

      <!-- Polvo suspendido en el haz: lo que delata que la luz es real. -->
      <g class="dm-motes" fill="#fff0e8">
        {motes.map((mote) => <circle class="dm-mote" cx={mote.cx} cy="290" r={mote.r} />)}
      </g>
    </g>
  </g>

  <!-- 3 · Hojas ------------------------------------------------------------
       Arqueadas: el remate de cada hoja sigue el intradós, así que la puerta
       es el arco y no hay montante fijo encima. La hoja derecha es la
       izquierda espejada dentro de su propio grupo — la simetría sale exacta
       y los cuarterones se escriben una sola vez.
       -------------------------------------------------------------------- -->
  <g class="dm-leaves" stroke-linecap="round" stroke-linejoin="round">
    <g class="door-leaf door-leaf--left">
      <g class="door-leaf__swing">
        <g class="door-leaf__sway">
          <path
            d="M 78 288 L 78 100 A 42 50 0 0 1 119 50 L 119 288 Z"
            fill={`url(#dm-leaf-l-${id})`}></path>
          <g stroke="#ff1a25" fill="none" filter={`url(#dm-neon-${id})`}>
            <path class="dm-w-leaf" d="M 78 288 L 78 100 A 42 50 0 0 1 119 50 L 119 288 Z"></path>

            <!-- Cuarterón alto, de remate curvo -->
            <path class="dm-w-panel" d="M 87 174 L 87 108 A 26 42 0 0 1 111 66 L 111 174 Z"></path>
            <path
              class="dm-w-panel-in"
              d="M 91 170 L 91 111 A 22 37 0 0 1 107 74 L 107 170 Z"
              opacity="0.6"></path>

            <!-- Rosetón labrado -->
            <g class="dm-w-detail" opacity="0.9">
              <circle cx="99" cy="194" r="9"></circle>
              <circle cx="99" cy="194" r="4.4" opacity="0.75"></circle>
              <g class="dm-w-hair" opacity="0.7">
                <line x1="99" y1="185" x2="99" y2="203"></line>
                <line x1="90" y1="194" x2="108" y2="194"></line>
                <line x1="92.6" y1="187.6" x2="105.4" y2="200.4"></line>
                <line x1="92.6" y1="200.4" x2="105.4" y2="187.6"></line>
              </g>
            </g>

            <!-- Cuarterón bajo -->
            <path class="dm-w-panel" d="M 87 216 L 111 216 L 111 276 L 87 276 Z"></path>
            <path
              class="dm-w-panel-in"
              d="M 91 220 L 107 220 L 107 272 L 91 272 Z"
              opacity="0.55"></path>

            <!-- Tirador, junto a la rendija -->
            <g class="dm-w-detail" opacity="0.85">
              <line class="dm-w-hair" x1="115" y1="186" x2="115" y2="202"></line>
              <circle cx="115" cy="194" r="2.2"></circle>
            </g>
          </g>
        </g>
      </g>
    </g>

    <g class="door-leaf door-leaf--right">
      <g class="door-leaf__swing">
        <g class="door-leaf__sway">
          <g transform="translate(240, 0) scale(-1, 1)">
            <path
              d="M 78 288 L 78 100 A 42 50 0 0 1 119 50 L 119 288 Z"
              fill={`url(#dm-leaf-l-${id})`}></path>
            <g stroke="#ff1a25" fill="none" filter={`url(#dm-neon-${id})`}>
              <path class="dm-w-leaf" d="M 78 288 L 78 100 A 42 50 0 0 1 119 50 L 119 288 Z"></path>

              <path class="dm-w-panel" d="M 87 174 L 87 108 A 26 42 0 0 1 111 66 L 111 174 Z"
              ></path>
              <path
                class="dm-w-panel-in"
                d="M 91 170 L 91 111 A 22 37 0 0 1 107 74 L 107 170 Z"
                opacity="0.6"></path>

              <g class="dm-w-detail" opacity="0.9">
                <circle cx="99" cy="194" r="9"></circle>
                <circle cx="99" cy="194" r="4.4" opacity="0.75"></circle>
                <g class="dm-w-hair" opacity="0.7">
                  <line x1="99" y1="185" x2="99" y2="203"></line>
                  <line x1="90" y1="194" x2="108" y2="194"></line>
                  <line x1="92.6" y1="187.6" x2="105.4" y2="200.4"></line>
                  <line x1="92.6" y1="200.4" x2="105.4" y2="187.6"></line>
                </g>
              </g>

              <path class="dm-w-panel" d="M 87 216 L 111 216 L 111 276 L 87 276 Z"></path>
              <path
                class="dm-w-panel-in"
                d="M 91 220 L 107 220 L 107 272 L 91 272 Z"
                opacity="0.55"></path>

              <g class="dm-w-detail" opacity="0.85">
                <line class="dm-w-hair" x1="115" y1="186" x2="115" y2="202"></line>
                <circle cx="115" cy="194" r="2.2"></circle>
              </g>
            </g>
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- 4 · La rendija -------------------------------------------------------
       La pieza más brillante del dibujo: la línea de luz entre las dos hojas.
       -------------------------------------------------------------------- -->
  <g class="dm-seam" filter={`url(#dm-seam-glow-${id})`}>
    <rect class="dm-blade" x="118.9" y="52" width="2.2" height="236" rx="1.1"
      fill={`url(#dm-seam-${id})`}></rect>
  </g>

  <!-- 5 · Carpintería: columnas, archivolta y cresta ------------------------
       La columna se dibuja una vez y se espeja: capitel labrado arriba, fuste
       estriado, basa moldurada en el suelo.
       -------------------------------------------------------------------- -->
  <g
    class="dm-frame"
    stroke="#ff1a25"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter={`url(#dm-neon-${id})`}
  >
    <!-- Archivolta: tres molduras concéntricas sobre las columnas -->
    <path
      class="dm-draw dm-w-arch"
      pathLength="1"
      d="M 58 100 A 62 70 0 0 1 182 100"></path>
    <path
      class="dm-draw dm-w-arch-mid"
      pathLength="1"
      d="M 66 100 A 54 62 0 0 1 174 100"
      opacity="0.8"></path>
    <path class="dm-draw dm-w-arch-in" pathLength="1" d="M 76 100 A 44 52 0 0 1 164 100"></path>

    {/* Cada columna: la izquierda dibujada, la derecha espejada. */}
    {[false, true].map((mirror) => (
      <g transform={mirror ? 'translate(240, 0) scale(-1, 1)' : undefined}>
        {/* Ábaco y capitel labrado */}
        <path class="dm-draw dm-w-orn" pathLength="1" d="M 54 82 L 82 82 L 82 88 L 54 88 Z"></path>
        <g class="dm-w-orn" opacity="0.9">
          <path d="M 57 88 C 58.5 93 60 96.5 60 100"></path>
          <path d="M 79 88 C 77.5 93 76 96.5 76 100"></path>
          <path d="M 63 88 C 64 92.5 65.5 96 66 100" opacity="0.75"></path>
          <path d="M 73 88 C 72 92.5 70.5 96 70 100" opacity="0.75"></path>
        </g>
        <g class="dm-w-hair" opacity="0.7">
          <path d="M 58 89.5 C 61 92 63.5 91 63.5 87.5"></path>
          <path d="M 78 89.5 C 75 92 72.5 91 72.5 87.5"></path>
        </g>

        {/* Fuste estriado */}
        <line class="dm-draw dm-w-col" pathLength="1" x1="60" y1="100" x2="60" y2="286"></line>
        <line class="dm-draw dm-w-col" pathLength="1" x1="76" y1="100" x2="76" y2="286"></line>
        <g class="dm-w-hair" opacity="0.55">
          <line x1="64.5" y1="106" x2="64.5" y2="280"></line>
          <line x1="68" y1="106" x2="68" y2="280"></line>
          <line x1="71.5" y1="106" x2="71.5" y2="280"></line>
        </g>
        <line class="dm-w-hair" x1="58" y1="100" x2="78" y2="100" opacity="0.8"></line>

        {/* Basa moldurada */}
        <g class="dm-w-orn">
          <path class="dm-draw" pathLength="1" d="M 58 286 L 78 286 L 78 291 L 58 291 Z"></path>
          <path class="dm-draw" pathLength="1" d="M 56 291 L 80 291 L 80 297 L 56 297 Z"
            opacity="0.85"></path>
          <path class="dm-draw" pathLength="1" d="M 53 297 L 83 297 L 83 306 L 53 306 Z"></path>
        </g>
      </g>
    ))}

    <!-- Umbral -->
    <line class="dm-draw dm-w-sill" pathLength="1" x1="46" y1="306" x2="194" y2="306"></line>
    <line class="dm-w-hair" x1="52" y1="311" x2="188" y2="311" opacity="0.5"></line>
  </g>

  <!-- 6 · Cresta -----------------------------------------------------------
       El remate barroco sobre la clave: cartucho, palmeta y volutas. Es el
       rasgo que hace reconocible a la marca de un vistazo, y por eso hereda
       el pulso de luz que antes tenía la estrella.
       -------------------------------------------------------------------- -->
  <g class="dm-star-in">
    <g
      class="dm-star"
      filter={`url(#dm-neon-${id})`}
      stroke="#ff1a25"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {[false, true].map((mirror) => (
        <g
          transform={`translate(120, 34) scale(1.1) translate(-120, -34)${
            mirror ? ' translate(240, 0) scale(-1, 1)' : ''
          }`}
        >
          <g class="dm-w-orn">
            {/* Cartucho: el cuerpo del que arranca todo lo demás */}
            <path d="M 120 34 C 126 34 129 31 129 27 C 129 23 126 21 120 21"></path>
            {/* Voluta: una sola espiral por lado, que muerde y enrolla */}
            <path d="M 120.5 30 C 127 30.5 132 27.5 133.5 22.5 C 135 17.5 131.5 14 128 15.5 C 125 16.8 124.5 20.5 127 21.8 C 129 22.8 131 21.4 130.6 19.4"></path>
            {/* Palmeta */}
            <path d="M 120 22 C 123.5 18 125.5 12 125 6"></path>
          </g>
          <g class="dm-w-hair" opacity="0.75">
            {/* Ala exterior, que devuelve la línea al arco */}
            <path d="M 131 27.5 C 135.5 28.5 139.5 26 140.5 22"></path>
            {/* Nervio de la palmeta */}
            <path d="M 120 27 C 122.5 24.5 124 21 124.2 17.5"></path>
          </g>
        </g>
      ))}
      {/* Remate: se posa justo donde se juntan las dos palmetas, no flotando
          por encima — en el logo la cresta acaba en sí misma. */}
      <circle cx="120" cy="3.4" r="1.7" fill="#fff2ec" stroke="none"></circle>
    </g>
  </g>

  <!-- 7 · Volumen: rayos, haz que sale y derrame ---------------------------- -->
  <g class="dm-rays-in">
    <g class="dm-rays" filter={`url(#dm-haze-${id})`} clip-path={`url(#dm-bounds-${id})`}>
      <path d="M 120 190 L 108 -70 L 132 -70 Z" fill={`url(#dm-ray-${id})`}></path>
      <path d="M 120 190 L 108 -70 L 132 -70 Z" fill={`url(#dm-ray-${id})`}
        transform="rotate(-34 120 190)"></path>
      <path d="M 120 190 L 108 -70 L 132 -70 Z" fill={`url(#dm-ray-${id})`}
        transform="rotate(34 120 190)"></path>
      <path d="M 120 190 L 111 -70 L 129 -70 Z" fill={`url(#dm-ray-${id})`}
        transform="rotate(-58 120 190)"></path>
      <path d="M 120 190 L 111 -70 L 129 -70 Z" fill={`url(#dm-ray-${id})`}
        transform="rotate(58 120 190)"></path>
    </g>
  </g>

  <!-- 8 · La luz que SALE por el vano --------------------------------------
       El haz que atraviesa el hueco y se proyecta hacia fuera. Va DELANTE de
       las hojas: la luz volumétrica se lee porque pasa por encima de lo que
       ilumina. Se mide en scaleX desde la boca de la puerta, así que abrir la
       puerta y ensanchar el haz son el mismo gesto.
       -------------------------------------------------------------------- -->
  <g class="dm-cast-in">
    <g class="dm-cast" clip-path={`url(#dm-bounds-${id})`} filter={`url(#dm-cast-blur-${id})`}>
      <path class="dm-cast-core" d="M 104 120 L 136 120 L 268 396 L -28 396 Z"
        fill={`url(#dm-cast-${id})`}></path>
