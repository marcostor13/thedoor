---
/**
 * Marca de la puerta — el icono que abre la animación de entrada y preside
 * el hero. Trazo rojo neón con resplandor SVG, quicio partido en dos leaves
 * que se abren en Intro.astro, y un halo central que se derrama sobre el
 * "suelo" al terminar la apertura.
 */
interface Props {
  class?: string
  id?: string
}

const { class: className, id = 'r1' } = Astro.props
---

<svg
  class={className}
  viewBox="0 0 200 270"
  role="img"
  aria-label="The Door PR"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <filter id={`glow-${id}`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.2" result="b1"></feGaussianBlur>
      <feGaussianBlur stdDeviation="5" result="b2"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b2"></feMergeNode>
        <feMergeNode in="b1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
    <filter id={`glow-strong-${id}`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="6" result="b1"></feGaussianBlur>
      <feGaussianBlur stdDeviation="14" result="b2"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b2"></feMergeNode>
        <feMergeNode in="b1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>
    <linearGradient id={`seam-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff2030" stop-opacity="0.1"></stop>
      <stop offset="0.5" stop-color="#ff5560" stop-opacity="1"></stop>
      <stop offset="1" stop-color="#ff2030" stop-opacity="0.2"></stop>
    </linearGradient>
    <radialGradient id={`floor-${id}`} cx="0.5" cy="0" r="0.7">
      <stop offset="0" stop-color="#ff1a25" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <g
    stroke="#ff1a25"
    stroke-width="1"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter={`url(#glow-${id})`}
  >
    <g class="door-frame">
      <path d="M 40 240 L 40 80 Q 40 30 100 30 Q 160 30 160 80 L 160 240"></path>
      <path
        d="M 50 240 L 50 82 Q 50 40 100 40 Q 150 40 150 82 L 150 240"
        stroke-width="0.7"
        opacity="0.85"></path>
      <g stroke-width="0.9">
        <path d="M 100 8 L 100 30"></path>
        <path d="M 92 12 Q 100 4 108 12"></path>
        <path d="M 88 18 Q 100 26 112 18"></path>
        <path d="M 88 18 Q 78 16 76 24 Q 75 30 82 30"></path>
        <path d="M 112 18 Q 122 16 124 24 Q 125 30 118 30"></path>
        <path
          d="M 96 16 L 96 24 Q 100 28 104 24 L 104 16 Q 100 14 96 16 Z"
          stroke-width="0.7"></path>
        <path d="M 82 30 Q 86 32 90 30" stroke-width="0.6"></path>
        <path d="M 110 30 Q 114 32 118 30" stroke-width="0.6"></path>
      </g>
      <g stroke-width="0.7">
        <line x1="40" y1="80" x2="40" y2="240"></line>
        <line x1="34" y1="80" x2="34" y2="249"></line>
        <line x1="160" y1="80" x2="160" y2="240"></line>
        <line x1="166" y1="80" x2="166" y2="249"></line>
      </g>
    </g>

    <g class="door-leaf door-leaf--left" transform="translate(-1 0)">
      <path d="M 52 240 L 52 84 Q 52 50 96 50 L 96 240 Z" stroke-width="0.8"></path>
      <path
        d="M 58 90 Q 60 60 92 60 L 92 110 L 58 110 Z"
        stroke-width="0.6"
        opacity="0.8"></path>
      <rect x="58" y="120" width="34" height="48" stroke-width="0.6" opacity="0.8"></rect>
      <rect x="58" y="178" width="34" height="56" stroke-width="0.6" opacity="0.8"></rect>
      <circle cx="90" cy="148" r="3" stroke-width="0.7"></circle>
      <circle cx="90" cy="148" r="1.2"></circle>
      <circle cx="75" cy="148" r="2" stroke-width="0.5" opacity="0.7"></circle>
    </g>

    <g class="door-leaf door-leaf--right" transform="translate(1 0)">
      <path d="M 148 240 L 148 84 Q 148 50 104 50 L 104 240 Z" stroke-width="0.8"></path>
      <path
        d="M 142 90 Q 140 60 108 60 L 108 110 L 142 110 Z"
        stroke-width="0.6"
        opacity="0.8"></path>
      <rect x="108" y="120" width="34" height="48" stroke-width="0.6" opacity="0.8"></rect>
      <rect x="108" y="178" width="34" height="56" stroke-width="0.6" opacity="0.8"></rect>
      <circle cx="110" cy="148" r="3" stroke-width="0.7"></circle>
      <circle cx="110" cy="148" r="1.2"></circle>
      <circle cx="125" cy="148" r="2" stroke-width="0.5" opacity="0.7"></circle>
    </g>
  </g>

  <g class="door-seam" filter={`url(#glow-strong-${id})`}>
    <rect x="98.5" y="50" width="3" height="195" fill={`url(#seam-${id})`}></rect>
    <ellipse class="door-floor-spill" cx="100" cy="246" rx="60" ry="8" fill={`url(#floor-${id})`}
    ></ellipse>
  </g>
</svg>

<style>
  svg {
    overflow: visible;
  }

  .door-leaf {
    transform-box: fill-box;
    transform-origin: left center;
  }

  .door-leaf--left {
    transform-origin: 52px 50%;
  }

  .door-leaf--right {
    transform-origin: 148px 50%;
  }
</style>
