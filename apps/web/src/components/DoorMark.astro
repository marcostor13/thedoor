---
/**
 * Marca de la puerta — el icono que preside el hero y protagoniza la
 * animación de entrada.
 *
 * Anatomía (viewBox 240 × 340):
 *   · Jamba de tres trazos + arco de medio punto sobre la línea de imposta.
 *   · Montante en abanico (fanlight) con radios y rosetón: es la pieza que
 *     más luz derrama, porque queda siempre por encima de las hojas.
 *   · Dos hojas macizas con relleno oscuro — ocultan el interior encendido
 *     y por eso la apertura se lee de verdad.
 *   · Sistema de luz: halo ambiental, foco interior, barrido, motas de polvo,
 *     rayos volumétricos, columna del quicio y derrame sobre el suelo.
 *
 * MOVIMIENTO — cada hoja es un sándwich de tres grupos que se multiplican,
 * para que las tres capas de animación no se peleen por `transform`:
 *
 *   .door-leaf           apertura base   scaleX(--leaf) = 0.5 (entreabierta)
 *   └ .door-leaf__swing  entrada         2 → 1  (de cerrada a su sitio)
 *     └ .door-leaf__sway vaivén eterno   1 ↔ 0.84
 *
 * El mismo truco con los envoltorios `*-in`: el bucle ambiental vive en el
 * elemento interior y la entrada en el envoltorio, así ninguna de las dos
 * tiene que reescribir a la otra.
 *
 * Con `staged` la marca nace invisible y espera a que le pongan `dm-enter`
 * (apertura completa) o `dm-settle` (solo asentarse, cuando la secuencia de
 * Intro.astro ya ha contado la apertura). De eso se encarga scripts/door.ts.
 */
interface Props {
  class?: string
  id?: string
  /** La entrada la dispara JS en vez de ocurrir al pintar. */
  staged?: boolean
  /**
   * `auto`  — apertura completa solo si no ha habido intro que la contara.
   * `full`  — apertura completa siempre; para páginas donde la puerta ES el
   *           contenido y no puede limitarse a asentarse.
   */
  entrance?: 'auto' | 'full'
}

const { class: className, id = 'r1', staged = false, entrance = 'auto' } = Astro.props

const motes = [
  { cx: 95, r: 1.2 },
  { cx: 103, r: 0.9 },
  { cx: 141, r: 1.3 },
  { cx: 148, r: 1 },
  { cx: 99, r: 1.1 },
  { cx: 145, r: 0.9 },
]
---

<svg
  class={`doormark ${staged ? 'doormark--staged' : ''} ${className ?? ''}`}
  data-door-entrance={staged ? entrance : undefined}
  viewBox="0 0 240 340"
  role="img"
  aria-label="The Door PR"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <filter id={`dm-soft-${id}`} x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="1.4" result="b1"></feGaussianBlur>
      <feGaussianBlur stdDeviation="4" result="b2"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b2"></feMergeNode>
        <feMergeNode in="b1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>

    <filter id={`dm-hot-${id}`} x="-70%" y="-70%" width="240%" height="240%">
      <feGaussianBlur stdDeviation="3" result="b1"></feGaussianBlur>
      <feGaussianBlur stdDeviation="10" result="b2"></feGaussianBlur>
      <feGaussianBlur stdDeviation="24" result="b3"></feGaussianBlur>
      <feMerge>
        <feMergeNode in="b3"></feMergeNode>
        <feMergeNode in="b2"></feMergeNode>
        <feMergeNode in="b1"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
      </feMerge>
    </filter>

    <filter id={`dm-haze-${id}`} x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="9"></feGaussianBlur>
    </filter>

    <!-- El haz que sale necesita menos difuminado que la calima: con 9 se
         disolvía en un halo sin forma y dejaba de leerse como un cono. -->
    <filter id={`dm-cast-blur-${id}`} x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="4.5"></feGaussianBlur>
    </filter>

    <!--
      NEÓN — lo que convierte una línea roja en un tubo encendido.

      Un trazo plano con un blur alrededor parece una línea con sombra, no
      neón. Un tubo real tiene tres cosas a la vez y aquí se montan en este
      orden: un halo de color que se derrama en el aire (tres pasadas de blur,
      de cerca a lejos), el propio trazo, y —la que de verdad lo delata— un
      núcleo más claro y más estrecho por dentro del trazo.

      Ese núcleo no se dibuja aparte: `feMorphology` adelgaza la silueta del
      propio trazo y se tiñe de blanco caliente. Así sale gratis para toda la
      carpintería, sin duplicar un solo path, y escala solo con el grosor —
      en los trazos finos la erosión se los come enteros y se quedan sin
      núcleo, que es justo lo que se quiere: los detalles no son tubos.
    -->
    <filter id={`dm-neon-${id}`} x="-50%" y="-50%" width="200%" height="200%">
      <feFlood flood-color="#ff1a25" result="tint"></feFlood>
      <feComposite in="tint" in2="SourceAlpha" operator="in" result="glow"></feComposite>

      <feGaussianBlur in="glow" stdDeviation="1.6" result="near"></feGaussianBlur>
      <feGaussianBlur in="glow" stdDeviation="5" result="mid"></feGaussianBlur>
      <feGaussianBlur in="glow" stdDeviation="13" result="far"></feGaussianBlur>

      <feMorphology in="SourceAlpha" operator="erode" radius="1" result="thin"></feMorphology>
      <feFlood flood-color="#fff4f0" result="hot"></feFlood>
      <feComposite in="hot" in2="thin" operator="in" result="core"></feComposite>
      <feGaussianBlur in="core" stdDeviation="0.45" result="coreSoft"></feGaussianBlur>

      <feMerge>
        <feMergeNode in="far"></feMergeNode>
        <feMergeNode in="far"></feMergeNode>
        <feMergeNode in="mid"></feMergeNode>
        <feMergeNode in="mid"></feMergeNode>
        <feMergeNode in="near"></feMergeNode>
        <feMergeNode in="SourceGraphic"></feMergeNode>
        <feMergeNode in="coreSoft"></feMergeNode>
      </feMerge>
    </filter>

    <!-- Aire encendido detrás de toda la pieza. -->
    <radialGradient id={`dm-halo-${id}`} cx="0.5" cy="0.58" r="0.5">
      <stop offset="0" stop-color="#ff2b36" stop-opacity="0.6"></stop>
      <stop offset="0.45" stop-color="#c00d18" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="#000000" stop-opacity="0"></stop>
    </radialGradient>

    <!-- Lo que hay al otro lado: blanco al rojo. -->
    <radialGradient id={`dm-inner-${id}`} cx="0.5" cy="0.66" r="0.62">
      <stop offset="0" stop-color="#fff6f0" stop-opacity="0.95"></stop>
      <stop offset="0.22" stop-color="#ff8a72" stop-opacity="0.8"></stop>
      <stop offset="0.55" stop-color="#ff1a25" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#3d0206" stop-opacity="0.15"></stop>
    </radialGradient>

    <linearGradient id={`dm-fan-${id}`} x1="0" y1="1" x2="0" y2="0">
      <stop offset="0" stop-color="#fff1e8" stop-opacity="0.85"></stop>
      <stop offset="0.6" stop-color="#ff3a44" stop-opacity="0.42"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0.12"></stop>
    </linearGradient>

    <!-- Barrido: la luz de dentro no está quieta. -->
    <linearGradient id={`dm-sweep-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff2ec" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#fff2ec" stop-opacity="0.4"></stop>
      <stop offset="1" stop-color="#fff2ec" stop-opacity="0"></stop>
    </linearGradient>

    <!-- Hoja: canto interior tocado por la luz, resto en penumbra. -->
    <linearGradient id={`dm-leaf-l-${id}`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#000000"></stop>
      <stop offset="0.62" stop-color="#0b0507"></stop>
      <stop offset="1" stop-color="#2a0a0d"></stop>
    </linearGradient>
    <linearGradient id={`dm-leaf-r-${id}`} x1="1" y1="0" x2="0" y2="0">
      <stop offset="0" stop-color="#000000"></stop>
      <stop offset="0.62" stop-color="#0b0507"></stop>
      <stop offset="1" stop-color="#2a0a0d"></stop>
    </linearGradient>

    <linearGradient id={`dm-seam-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ff2030" stop-opacity="0.05"></stop>
      <stop offset="0.35" stop-color="#fff0ea" stop-opacity="0.95"></stop>
      <stop offset="0.75" stop-color="#ff5560" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#ff2030" stop-opacity="0.15"></stop>
    </linearGradient>

    <linearGradient id={`dm-beam-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff2ec" stop-opacity="0.7"></stop>
      <stop offset="0.35" stop-color="#ff5560" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </linearGradient>

    <linearGradient
      id={`dm-ray-${id}`}
      gradientUnits="userSpaceOnUse"
      x1="120"
      y1="205"
      x2="120"
      y2="-60"
    >
      <stop offset="0" stop-color="#ffd9d2" stop-opacity="0.5"></stop>
      <stop offset="0.4" stop-color="#ff4d58" stop-opacity="0.14"></stop>
      <stop offset="0.72" stop-color="#ff1a25" stop-opacity="0"></stop>
    </linearGradient>

    <!-- Luz que cruza el vano y se proyecta hacia fuera: caliente en la boca
         de la puerta, disuelta en el aire a medida que se aleja. -->
    <linearGradient id={`dm-cast-${id}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff6f2" stop-opacity="0.78"></stop>
      <stop offset="0.22" stop-color="#ff8478" stop-opacity="0.46"></stop>
      <stop offset="0.58" stop-color="#ff2a35" stop-opacity="0.19"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </linearGradient>

    <radialGradient id={`dm-floor-${id}`} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#ffece6" stop-opacity="0.75"></stop>
      <stop offset="0.4" stop-color="#ff1a25" stop-opacity="0.34"></stop>
      <stop offset="1" stop-color="#ff1a25" stop-opacity="0"></stop>
    </radialGradient>

    <clipPath id={`dm-bounds-${id}`}>
      <rect x="-70" y="-50" width="380" height="450"></rect>
    </clipPath>

    <clipPath id={`dm-clip-${id}`}>
      <path d="M 46 296 L 46 132 A 74 74 0 0 1 194 132 L 194 296 Z"></path>
    </clipPath>
  </defs>

  <!-- 1 · Aire ------------------------------------------------------------ -->
  <g class="dm-halo-in">
    <ellipse class="dm-halo" cx="120" cy="190" rx="150" ry="170" fill={`url(#dm-halo-${id})`}
    ></ellipse>
  </g>

  <!-- 2 · Lo que hay detrás de la puerta ---------------------------------- -->
  <g class="dm-inside-in">
    <g class="dm-inside" clip-path={`url(#dm-clip-${id})`}>
      <rect x="46" y="52" width="148" height="248" fill={`url(#dm-inner-${id})`}></rect>
      <path
        class="dm-fanlight-fill"
        d="M 46 132 A 74 74 0 0 1 194 132 Z"
        fill={`url(#dm-fan-${id})`}></path>

      <!-- Una onda de luz sube por el hueco cada pocos segundos. -->
      <rect class="dm-sweep" x="46" y="250" width="148" height="56" fill={`url(#dm-sweep-${id})`}
      ></rect>

      <!-- Polvo suspendido en el haz: lo que delata que la luz es real. -->
      <g class="dm-motes" fill="#fff0e8">
        {motes.map((mote) => <circle class="dm-mote" cx={mote.cx} cy="290" r={mote.r} />)}
      </g>
    </g>
  </g>

  <!-- 3 · Hojas ----------------------------------------------------------- -->
  <g class="dm-leaves" stroke-linecap="round" stroke-linejoin="round">
    <g class="door-leaf door-leaf--left">
      <g class="door-leaf__swing">
        <g class="door-leaf__sway">
          <path d="M 48 294 L 48 136 L 118 136 L 118 294 Z" fill={`url(#dm-leaf-l-${id})`}></path>
          <g stroke="#ff1a25" fill="none" filter={`url(#dm-neon-${id})`}>
            <path d="M 48 294 L 48 136 L 118 136 L 118 294 Z" class="dm-w-leaf"></path>
            <rect x="56" y="148" width="46" height="60" class="dm-w-panel" opacity="0.75"></rect>
            <rect x="60" y="152" width="38" height="52" class="dm-w-panel-in" opacity="0.4"></rect>
            <rect x="56" y="220" width="46" height="60" class="dm-w-panel" opacity="0.75"></rect>
            <rect x="60" y="224" width="38" height="52" class="dm-w-panel-in" opacity="0.4"></rect>
            <rect x="106" y="198" width="9" height="32" class="dm-w-plate" opacity="0.7"></rect>
            <circle cx="110.5" cy="214" r="3" class="dm-w-knob"></circle>
          </g>
        </g>
      </g>
    </g>

    <g class="door-leaf door-leaf--right">
      <g class="door-leaf__swing">
        <g class="door-leaf__sway">
          <path d="M 192 294 L 192 136 L 122 136 L 122 294 Z" fill={`url(#dm-leaf-r-${id})`}></path>
          <g stroke="#ff1a25" fill="none" filter={`url(#dm-neon-${id})`}>
            <path d="M 192 294 L 192 136 L 122 136 L 122 294 Z" class="dm-w-leaf"></path>
            <rect x="138" y="148" width="46" height="60" class="dm-w-panel" opacity="0.75"></rect>
            <rect x="142" y="152" width="38" height="52" class="dm-w-panel-in" opacity="0.4"></rect>
            <rect x="138" y="220" width="46" height="60" class="dm-w-panel" opacity="0.75"></rect>
            <rect x="142" y="224" width="38" height="52" class="dm-w-panel-in" opacity="0.4"></rect>
            <rect x="125" y="198" width="9" height="32" class="dm-w-plate" opacity="0.7"></rect>
            <circle cx="129.5" cy="214" r="3" class="dm-w-knob"></circle>
          </g>
        </g>
      </g>
    </g>
  </g>

  <!-- 4 · Quicio encendido ------------------------------------------------- -->
  <g class="dm-seam" filter={`url(#dm-hot-${id})`}>
    <rect
      class="dm-blade"
      x="118"
      y="136"
      width="4"
      height="158"
      rx="2"
      fill={`url(#dm-seam-${id})`}></rect>
  </g>

  <!-- 5 · Carpintería ------------------------------------------------------ -->
  <g
    class="dm-frame"
    stroke="#ff1a25"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    filter={`url(#dm-neon-${id})`}
  >
    <path
      pathLength="1"
      d="M 30 304 L 30 132 A 90 90 0 0 1 210 132 L 210 304"
      class="dm-draw dm-w-arch"></path>
    <path
      pathLength="1"
      d="M 40 298 L 40 132 A 80 80 0 0 1 200 132 L 200 298"
      class="dm-draw dm-w-arch-mid"
      opacity="0.75"></path>
    <path
      pathLength="1"
      d="M 46 296 L 46 132 A 74 74 0 0 1 194 132 L 194 296"
      class="dm-draw dm-w-arch-in"></path>

    <!-- Imposta -->
    <line class="dm-draw dm-w-impost" pathLength="1" x1="36" y1="132" x2="204" y2="132"
    ></line>
    <line
      pathLength="1"
      x1="42"
      y1="127"
      x2="198"
      y2="127"
      class="dm-draw dm-w-hair"
      opacity="0.6"></line>

    <!-- Abanico -->
    <g class="dm-fan dm-w-fan" opacity="0.9">
      <line class="dm-draw" pathLength="1" x1="120" y1="132" x2="184.1" y2="95"></line>
      <line class="dm-draw" pathLength="1" x1="120" y1="132" x2="157" y2="67.9"></line>
      <line class="dm-draw" pathLength="1" x1="120" y1="132" x2="120" y2="58"></line>
      <line class="dm-draw" pathLength="1" x1="120" y1="132" x2="83" y2="67.9"></line>
      <line class="dm-draw" pathLength="1" x1="120" y1="132" x2="55.9" y2="95"></line>
      <path pathLength="1" d="M 94 132 A 26 26 0 0 1 146 132" class="dm-draw dm-w-fan-arc"
      ></path>
    </g>

    <!-- Goznes -->
    <g class="dm-hinges dm-w-detail" opacity="0.7">
      <rect x="42" y="162" width="8" height="13"></rect>
      <rect x="42" y="208" width="8" height="13"></rect>
      <rect x="42" y="254" width="8" height="13"></rect>
      <rect x="190" y="162" width="8" height="13"></rect>
      <rect x="190" y="208" width="8" height="13"></rect>
      <rect x="190" y="254" width="8" height="13"></rect>
    </g>

    <!-- Clave del arco -->
    <path pathLength="1" d="M 111 52 L 129 52 L 132 30 L 108 30 Z" class="dm-draw dm-w-key"
    ></path>

    <!-- Umbral -->
    <line class="dm-draw dm-w-sill" pathLength="1" x1="22" y1="296" x2="218" y2="296"></line>
    <line
      pathLength="1"
      x1="28"
      y1="302"
      x2="212"
      y2="302"
      class="dm-draw dm-w-hair"
      opacity="0.55"></line>
  </g>

  <!-- 6 · La luz de encima de la puerta ------------------------------------ -->
  <g class="dm-star-in">
    <g class="dm-star" filter={`url(#dm-hot-${id})`} stroke="#ff5560" fill="none">
      <path
        d="M 120 4 L 124.5 16 L 120 28 L 115.5 16 Z"
        stroke-width="0.7"
        fill="#ff8a90"
        fill-opacity="0.25"></path>
      <line x1="105" y1="16" x2="135" y2="16" stroke-width="0.5" opacity="0.75"></line>
      <circle cx="120" cy="16" r="1.6" fill="#fff2ec" stroke="none"></circle>
    </g>
  </g>

  <!-- 7 · Volumen: rayos, columna y derrame -------------------------------- -->
  <g class="dm-rays-in">
    <g class="dm-rays" filter={`url(#dm-haze-${id})`} clip-path={`url(#dm-bounds-${id})`}>
      <path d="M 120 205 L 102 -60 L 136 -60 Z" fill={`url(#dm-ray-${id})`}></path>
      <path
        d="M 120 205 L 102 -60 L 136 -60 Z"
        fill={`url(#dm-ray-${id})`}
        transform="rotate(-38 120 205)"></path>
      <path
        d="M 120 205 L 102 -60 L 136 -60 Z"
        fill={`url(#dm-ray-${id})`}
        transform="rotate(38 120 205)"></path>
      <path
        d="M 120 205 L 106 -60 L 132 -60 Z"
        fill={`url(#dm-ray-${id})`}
        transform="rotate(-61 120 205)"></path>
      <path
        d="M 120 205 L 106 -60 L 132 -60 Z"
        fill={`url(#dm-ray-${id})`}
        transform="rotate(61 120 205)"></path>
    </g>
  </g>

  <!-- 8 · La luz que SALE por el vano --------------------------------------
       Hasta aquí la marca tenía luz dentro y un derrame en el suelo, pero
       nada que cruzara el umbral: la puerta se abría y el resplandor se
       quedaba al otro lado. Esto es el haz que atraviesa el hueco y se
       proyecta hacia fuera, y por eso va DELANTE de las hojas: la luz
       volumétrica se lee porque pasa por encima de lo que ilumina.

       En reposo va estrecho y contenido —la puerta solo está entreabierta—;
       al abrirse de par en par se ensancha y sube de intensidad. Ese cambio
       ES la apertura, más que el giro de las hojas.
       -------------------------------------------------------------------- -->
  <g class="dm-cast-in">
    <g class="dm-cast" clip-path={`url(#dm-bounds-${id})`} filter={`url(#dm-cast-blur-${id})`}>
      <path class="dm-cast-core" d="M 62 146 L 178 146 L 292 392 L -52 392 Z"
        fill={`url(#dm-cast-${id})`}></path>
      <path class="dm-cast-fin" d="M 62 146 L 112 146 L 44 392 L -66 392 Z"
        fill={`url(#dm-cast-${id})`} opacity="0.45"></path>
      <path class="dm-cast-fin" d="M 128 146 L 178 146 L 306 392 L 196 392 Z"
        fill={`url(#dm-cast-${id})`} opacity="0.45"></path>
    </g>
  </g>

  <g class="dm-spill">
    <path
      class="dm-beam"
      d="M 84 290 L 156 290 L 236 344 L 4 344 Z"
      fill={`url(#dm-beam-${id})`}
      filter={`url(#dm-haze-${id})`}></path>
    <ellipse class="dm-pool" cx="120" cy="297" rx="98" ry="16" fill={`url(#dm-floor-${id})`}
    ></ellipse>
    <!-- Donde el haz muerde el umbral: la línea más caliente de la marca. -->
    <rect
      class="dm-threshold"
      x="86"
      y="294.5"
      width="68"
      height="1.6"
      rx="0.8"
      fill="#ffe3d9"
      opacity="0.75"
      filter={`url(#dm-hot-${id})`}></rect>
  </g>
</svg>

<style>
  .doormark {
    overflow: visible;
    /* Apertura de reposo: 0.5 ≈ hoja girada 60° vista de frente. */
    --leaf: 0.5;

    /* -----------------------------------------------------------------------
       GROSORES — el carácter de la marca vive aquí.

       La marca es un rótulo de neón, y un tubo de neón es grueso: la marca
       pequeña (DoorGlyph, favicon) siempre lo fue —su arco exterior pesa un
       4 % del ancho— pero esta grande se había quedado en un 0,46 %, nueve
       veces más fina, y a tamaño de hero se leía como un plano técnico en vez
       de como un letrero encendido.

       Todos los trazos se miden contra el viewBox de 240, y van juntos: si se
       sube uno hay que subir el resto o la jerarquía se rompe. Por eso están
       aquí y no repartidos en treinta atributos del markup.
       -------------------------------------------------------------------- */
    --dm-w-arch: 5;
    --dm-w-arch-mid: 2.6;
    --dm-w-arch-in: 3.8;
    --dm-w-impost: 3.8;
    --dm-w-fan: 2.4;
    --dm-w-fan-arc: 3;
    --dm-w-key: 3.2;
    --dm-w-sill: 4.4;
    --dm-w-leaf: 4;
    --dm-w-panel: 2.4;
    --dm-w-panel-in: 1.5;
    --dm-w-plate: 2;
    --dm-w-knob: 2.8;
    --dm-w-detail: 2.2;
    --dm-w-hair: 1.6;
  }

  .dm-w-arch { stroke-width: var(--dm-w-arch); }
  .dm-w-arch-mid { stroke-width: var(--dm-w-arch-mid); }
  .dm-w-arch-in { stroke-width: var(--dm-w-arch-in); }
  .dm-w-impost { stroke-width: var(--dm-w-impost); }
  .dm-w-fan { stroke-width: var(--dm-w-fan); }
  .dm-w-fan-arc { stroke-width: var(--dm-w-fan-arc); }
  .dm-w-key { stroke-width: var(--dm-w-key); }
  .dm-w-sill { stroke-width: var(--dm-w-sill); }
  .dm-w-leaf { stroke-width: var(--dm-w-leaf); }
  .dm-w-panel { stroke-width: var(--dm-w-panel); }
  .dm-w-panel-in { stroke-width: var(--dm-w-panel-in); }
  .dm-w-plate { stroke-width: var(--dm-w-plate); }
  .dm-w-knob { stroke-width: var(--dm-w-knob); }
  .dm-w-detail { stroke-width: var(--dm-w-detail); }
  .dm-w-hair { stroke-width: var(--dm-w-hair); }

  /* =========================================================================
     HAZ PROYECTADO — la luz que cruza el umbral
     ====================================================================== */

  /* Se mide en scaleX desde la boca de la puerta: el haz es tan ancho como el
     hueco que lo deja pasar, así que abrir la puerta y ensanchar el haz son
     el mismo gesto. `--cast` acompaña a `--leaf`. */
  .dm-cast {
    transform-box: fill-box;
    transform-origin: 50% 0%;
    transform: scaleX(var(--cast, 0.5));
    opacity: var(--cast-lit, 0.45);
    will-change: transform, opacity;
  }

  /* =========================================================================
     HOJAS — tres capas que se multiplican (ver cabecera del componente)
     ====================================================================== */

  .door-leaf,
  .door-leaf__swing,
  .door-leaf__sway {
    transform-box: fill-box;
  }

  .door-leaf--left,
  .door-leaf--left .door-leaf__swing,
  .door-leaf--left .door-leaf__sway {
    transform-origin: 0% 50%;
  }

  .door-leaf--right,
  .door-leaf--right .door-leaf__swing,
  .door-leaf--right .door-leaf__sway {
    transform-origin: 100% 50%;
  }

  .door-leaf {
    transform: scaleX(var(--leaf));
  }

  /* =========================================================================
     BUCLE AMBIENTAL — la marca nunca está del todo quieta
     ====================================================================== */

  .door-leaf__sway {
    will-change: transform;
    animation: dm-sway 13s var(--ease-in-out) infinite;
  }

  /* La hoja derecha va medio compás por detrás: al unísono parecen un
     acordeón; desfasadas parecen una corriente de aire. */
  .door-leaf--right .door-leaf__sway {
    animation-delay: -4.5s;
  }

  .dm-halo {
    transform-origin: 120px 190px;
    animation: dm-breathe 7s var(--ease-in-out) infinite;
  }

  .dm-inside {
    animation: dm-inside-breathe 13s var(--ease-in-out) infinite;
  }

  .dm-sweep {
    animation: dm-sweep 6.5s var(--ease-in-out) infinite;
  }

  .dm-mote {
    animation: dm-mote 9s linear infinite;
  }

  .dm-mote:nth-child(2) {
    animation-duration: 12s;
    animation-delay: -2.5s;
  }

  .dm-mote:nth-child(3) {
    animation-name: dm-mote-drift;
    animation-duration: 10.5s;
    animation-delay: -6s;
  }

  .dm-mote:nth-child(4) {
    animation-duration: 13.5s;
    animation-delay: -9s;
  }

  .dm-mote:nth-child(5) {
    animation-name: dm-mote-drift;
    animation-duration: 11s;
    animation-delay: -4s;
  }

  .dm-mote:nth-child(6) {
    animation-duration: 15s;
    animation-delay: -12s;
  }

  .dm-rays {
    transform-origin: 120px 205px;
    opacity: 0.62;
    animation: dm-rays-breathe 11s var(--ease-in-out) infinite;
  }

  .dm-seam {
    animation: dm-flicker 9s linear infinite;
  }

  /* En reposo el quicio ya no es una rendija sino la columna de luz que
     ocupa el hueco entreabierto; la entrada la abre desde la cuchilla. */
  .dm-blade {
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleX(var(--seam, 6));
  }

  /* Zumbido de neón: la carpintería duda un instante de vez en cuando. */
  .dm-frame {
    animation: dm-neon 8s linear infinite;
  }

  .dm-star {
    transform-origin: 120px 16px;
    animation: dm-star-pulse 5s var(--ease-in-out) infinite;
  }

  .dm-pool,
  .dm-threshold {
    animation: dm-inside-breathe 13s var(--ease-in-out) infinite;
  }

  @keyframes dm-sway {
    0%,
    100% {
      transform: scaleX(1);
    }
    38% {
      transform: scaleX(0.84);
    }
    64% {
      transform: scaleX(0.93);
    }
  }

  @keyframes dm-breathe {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.055);
    }
  }

  /* Mismo perfil que dm-sway: el pico de luz cae donde la puerta está más
     abierta. */
  @keyframes dm-inside-breathe {
    0%,
    100% {
      opacity: 0.8;
    }
    38% {
      opacity: 1;
    }
    64% {
      opacity: 0.9;
    }
  }

  @keyframes dm-sweep {
