---
import Layout from '../layouts/Layout.astro'
import ContactForm from '../components/ContactForm.astro'
import DoorMark from '../components/DoorMark.astro'
import Logo from '../components/Logo.astro'
import { SITE } from '../data/navigation'

const services = [
  {
    num: '01',
    title: 'Venue Programming',
    desc: 'Construimos el calendario — residencias, takeovers, noches temáticas. Desde el soft opening hasta el primer aniversario, tu sala no se apaga un martes.',
    tag: 'Calendars, residencies, takeovers',
    label: 'Ongoing',
  },
  {
    num: '02',
    title: 'Guest Curation',
    desc: 'Una cartera filtrada de más de 4,000 — finanzas, moda, música, hospitalidad. Confirmamos a la gente que convierte un miércoles en sábado.',
    tag: 'Vetted clientele, never sold',
    label: 'Per night',
  },
  {
    num: '03',
    title: 'Private & VIP',
    desc: 'Cumpleaños. Lanzamientos. Reservas corporativas discretas. Nosotros manejamos el manifiesto, el lugar, el momento — tú haces el brindis.',
    tag: 'Birthdays, launches, buyouts',
    label: 'One-off',
  },
  {
    num: '04',
    title: 'Press & Profile',
    desc: 'Notas de fondo, listados, la mención correcta en el medio correcto en el momento correcto. Hacemos que se hable de tu sala con la gente que importa.',
    tag: 'Editorial, listings, longform',
    label: 'Retainer',
  },
]

const stats = [
  { num: '60+', desc: 'Venues represented in Lima since 2019.' },
  { num: '4.2K', desc: 'Guests on the curated list. Vetted, never sold.' },
  { num: '1:1', desc: 'Every venue gets a dedicated programmer. No interns.' },
  { num: '00', desc: 'Walk-ins. Cover charges. Bottle minimums.' },
]

const rosterRowA = [
  'Maison Noir',
  'Carbón',
  'Bar Once',
  'Hotel B',
  'Sable & Humo',
  'La Bóveda',
  'Lila Rooftop',
  'Quince',
  'Apertura',
  'Foxglove',
  'Le Petit Roi',
  'Sundown',
]

const rosterRowB = [
  'Malecón',
  'Marlowe',
  'Invernadero',
  'Velvet Room',
  'Hotel Embajada',
  'Camille',
  'Casa Aria',
  'Calloway',
  'Atelier',
  'Margot',
  'La Emperatriz',
  'Onyx',
]

const contactRows = [
  { label: 'Locales', value: 'venues@thedoor.pe', href: 'mailto:venues@thedoor.pe' },
  { label: 'Lista', value: 'list@thedoor.pe', href: 'mailto:list@thedoor.pe' },
  { label: 'Prensa', value: 'press@thedoor.pe', href: 'mailto:press@thedoor.pe' },
  { label: 'Lima', value: 'Av. La Paz 1040, Miraflores' },
  { label: 'Barranco', value: 'Bajada de Baños 393' },
  { label: 'Citas', value: 'Solo con cita previa' },
]
---

<Layout title={`${SITE.name} — PR for hospitality, nightlife & the people who fill the rooms`} intro>
  <section id="top" class="hero">
    <span class="hero__aura" aria-hidden="true"></span>

    <div class="container hero__inner">
      <div class="hero__topbar">
        <span>{SITE.city}</span>
        <span class="hero__topbar-right">
          <em>Solo miembros</em>
          <span>MMXXVI</span>
        </span>
      </div>

      <div class="hero__stage">
        <DoorMark class="hero__mark" id="hero" state="ajar" />
        <Logo class="hero__wordmark" />
        <span class="hero__rule" aria-hidden="true"></span>
      </div>

      <p class="hero__tagline">
        Doors don’t open for everyone. Ours do — <em>for the right people, on the right
        nights.</em>
      </p>

      <div class="hero__foot">
        <p class="hero__eyebrow">{SITE.description.toUpperCase()}</p>
        <a class="hero__scroll" href="#services">
          After hours / 01 — 03 <span class="hero__scroll-cue" aria-hidden="true"></span> Baja
        </a>
      </div>
    </div>
  </section>

  <section class="section question">
    <div class="container">
      <p class="eyebrow" data-reveal>The question</p>
      <h2 class="question__title">
        <span data-reveal="rise">Are you in?</span>
        <em data-reveal="rise">Or are you out?</em>
      </h2>
      <p class="manifesto" data-reveal>
        Anyone can fill a room. We fill it with the people who come back.
      </p>
    </div>

    <div class="container stat-grid" data-reveal-stagger="90">
      {
        stats.map((stat) => (
          <div class="stat-grid__item" data-reveal>
            <p class="stat-grid__num">{stat.num}</p>
            <p class="stat-grid__desc">{stat.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="services" class="section services">
    <div class="container services__head">
      <p class="eyebrow" data-reveal>What we do</p>
      <h2 class="services__title" data-reveal="rise">
        Four things, on repeat — for venues that take the door seriously.
      </h2>
    </div>

    <div class="container">
      {
        services.map((service) => (
          <article class="service-row" data-reveal>
            <span class="service-row__num">{service.num} /</span>
            <h3 class="service-row__title">{service.title}</h3>
            <p class="service-row__desc">{service.desc}</p>
            <span class="service-row__tag">{service.tag}</span>
            <span class="service-row__label">{service.label}</span>
          </article>
        ))
      }
    </div>
  </section>

  <section id="roster" class="section roster">
    <div class="container roster__head">
      <p class="eyebrow" data-reveal>Selección de socios / NDA en el resto</p>
      <h2 class="roster__title" data-reveal="rise">Rooms we keep full.</h2>
      <span class="roster__meta">2024 — 2026</span>
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track marquee__track--a">
        {
          [...rosterRowA, ...rosterRowA].map((name) => (
            <span class="marquee__item">
              {name}
              <span class="marquee__dot" />
            </span>
          ))
        }
      </div>
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="marquee__track marquee__track--b">
        {
          [...rosterRowB, ...rosterRowB].map((name) => (
            <span class="marquee__item">
              {name}
              <span class="marquee__dot" />
            </span>
          ))
        }
      </div>
    </div>

    <p class="visually-hidden">
      {[...rosterRowA, ...rosterRowB].join(', ')}
    </p>

    <div class="container roster__foot">
      <span>— 60+ locales, una sola ciudad</span>
      <a class="roster__cta" href="#contact">Pide la lista completa →</a>
    </div>
  </section>

  <section id="apply" class="section apply">
    <div class="apply__col" data-reveal>
      <div>
        <p class="eyebrow">For venues</p>
        <h3 class="apply__title">Put us on the door.</h3>
        <p class="apply__desc">
          Bares, hoteles, restaurantes. Tomamos una cartera reducida y la llenamos —
          silenciosamente, consistentemente, con las caras correctas. Cuéntanos del local
          y la noche que quieres correr.
        </p>
      </div>

      <ul role="list" class="apply__bullets">
        <li>Aceptamos 4 locales nuevos por trimestre</li>
        <li>Compromiso mínimo de 6 meses</li>
        <li>Referencias bajo pedido</li>
      </ul>

      <a class="apply__arrow" href="mailto:venues@thedoor.pe">Pitch your venue →</a>
    </div>

    <div class="apply__col apply__col--list" data-reveal>
      <div>
        <p class="eyebrow">For the list</p>
        <h3 class="apply__title">Get on the list.</h3>
        <p class="apply__desc">
          Mantenemos una cartera filtrada de invitados que reciben primer aviso de
          residencias, aperturas y salones privados en nuestros locales. Sin app. Sin
          cobro. Solo por referencia — pero puedes presentarte.
        </p>
      </div>

      <ul role="list" class="apply__bullets">
        <li>Por referencia, nunca vendida</li>
        <li>De tres a cinco invitaciones por mes</li>
        <li>Te das de baja cuando quieras</li>
      </ul>

      <a class="apply__arrow" href="mailto:list@thedoor.pe">Request an introduction →</a>
    </div>
  </section>

  <section id="contact" class="section contact">
    <div class="container contact__grid">
      <div>
        <p class="eyebrow" data-reveal>Contact</p>
        <h2 class="contact__title" data-reveal="rise">
          Knock once. <em>We’ll answer.</em>
        </h2>
        <ContactForm />
      </div>

      <dl class="contact__rows" data-reveal>
        {
          contactRows.map((row) => (
            <div class="contact__row">
              <dt>{row.label}</dt>
              <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Layout>

<style>
  /* --- Hero ------------------------------------------------------------- */
  .hero {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: 100svh;
    padding-block: var(--sp-lg);
    overflow: hidden;
  }

  /* El aura que proyecta la puerta sobre la sala. Va detrás del contenido y
     respira con el mismo compás que el neón del SVG, así que la luz de la
     página y la de la marca son la misma luz. */
  .hero__aura {
    position: absolute;
    inset-block-start: 34%;
    inset-inline-start: 50%;
    width: min(120vw, 60rem);
    aspect-ratio: 1;
    translate: -50% -40%;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      rgb(255 26 37 / 0.16) 0%,
      rgb(255 26 37 / 0.06) 42%,
      transparent 72%
    );
    animation: aura-breathe 6s var(--ease-in-out) infinite;
  }

  @keyframes aura-breathe {
    0%,
    100% {
      opacity: 0.75;
      scale: 0.97;
    }
    50% {
      opacity: 1;
      scale: 1.03;
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: calc(100svh - var(--header-h));
    gap: var(--sp-xl);
  }

  .hero__topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .hero__topbar-right {
    display: flex;
    gap: var(--sp-md);
  }

  .hero__topbar-right em {
    font-style: normal;
    color: var(--c-accent);
  }

  /* El separador es un punto, no un guion mecanografiado: no se confunde con
     el guion de los antetítulos y no cambia de ancho con la fuente. */
  .hero__topbar-right em::before,
  .hero__topbar-right em::after {
    content: '·';
    margin-inline: 0.6em;
    color: var(--c-fg-faint);
  }

  .hero__stage {
    display: grid;
    justify-items: center;
    gap: var(--sp-md);
    text-align: center;
  }

  :global(.hero__mark) {
    width: min(42vw, 14rem);
    height: auto;
  }

  :global(.hero__wordmark) {
    font-size: var(--fs-2xl);
  }

  .hero__rule {
    width: 2.5rem;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-md);
  }

  .hero__tagline {
    max-width: 44rem;
    margin-inline: auto;
    font-family: var(--font-serif-body);
    font-style: italic;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.5rem);
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    color: var(--c-fg);
  }

  .hero__tagline em {
    color: var(--c-accent);
    font-style: italic;
    text-shadow: var(--text-glow-md);
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md);
    align-items: flex-end;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .hero__eyebrow {
    max-width: 22rem;
  }

  .hero__scroll {
    display: flex;
    align-items: center;
    gap: var(--sp-2xs);
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hero__scroll:hover {
    color: var(--c-fg);
  }

  /* Un trazo que se alarga y se retira: la única invitación a bajar que no
     necesita una flecha rebotando. */
  .hero__scroll-cue {
    width: 2.5rem;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-xs);
    transform-origin: 0 50%;
    animation: cue-draw 2.8s var(--ease-in-out) infinite;
  }

  @keyframes cue-draw {
    0%,
    100% {
      transform: scaleX(0.25);
      opacity: 0.5;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  /* --- Question / stats --------------------------------------------------- */
  .question__title {
    display: grid;
    margin-block-start: var(--sp-md);
    font-size: var(--fs-5xl);
    line-height: 0.95;
  }

  .question__title em {
    font-style: italic;
    color: var(--c-accent);
    text-shadow: var(--text-glow-lg);
  }

  .manifesto {
    max-width: 34rem;
    margin-block-start: var(--sp-xl);
    font-family: var(--font-serif-body);
    font-style: italic;
    font-size: var(--fs-xl);
    color: var(--c-fg);
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-lg);
    margin-block-start: var(--sp-2xl);
    padding-block-start: var(--sp-lg);
    border-top: 1px solid var(--c-border);
  }

  .stat-grid__num {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    text-transform: uppercase;
    color: var(--c-fg);
  }

  .stat-grid__desc {
    margin-block-start: var(--sp-2xs);
    font-size: var(--fs-sm);
    color: var(--c-fg-muted);
    text-wrap: pretty;
  }

  @media (max-width: 860px) {
    .stat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 460px) {
    .stat-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-md);
    }
  }

  /* --- Services ------------------------------------------------------------ */
  .services__head {
    display: grid;
    gap: var(--sp-md);
    margin-block-end: var(--sp-xl);
  }

  .services__title {
    max-width: 46rem;
    font-size: var(--fs-3xl);
  }

  .service-row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'num title label' 'num desc label' 'num tag label';
    column-gap: var(--sp-lg);
    row-gap: var(--sp-2xs);
    align-items: start;
    padding-block: var(--sp-lg);
    /* El padding lateral es lo que permite que el resaltado ocupe toda la fila;
       el margen negativo devuelve el texto a la retícula del contenedor. El
       sangrado nunca puede pasar del gutter, o en pantallas estrechas la fila
       se saldría del viewport y aparecería scroll horizontal. */
    padding-inline: min(var(--sp-md), var(--gutter));
    margin-inline: calc(min(var(--sp-md), var(--gutter)) * -1);
    border-top: 1px solid var(--c-border);
    transition: background var(--dur-base) var(--ease-out);
  }

  .service-row:last-of-type {
    border-bottom: 1px solid var(--c-border);
  }

  /* La línea superior se reilumina en rojo al pasar por encima, creciendo
     desde el borde de entrada. La fila entera se comporta como una puerta. */
  .service-row::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline: 0;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-sm);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .service-row:hover {
    background: linear-gradient(90deg, rgb(255 26 37 / 0.05), transparent 65%);
  }

  .service-row:hover::before {
    transform: scaleX(1);
  }

  .service-row__num {
    grid-area: num;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-accent);
    text-shadow: var(--text-glow-sm);
  }

  .service-row__title {
    grid-area: title;
    font-size: var(--fs-3xl);
    transition: color var(--dur-base) var(--ease-out);
  }

  .service-row:hover .service-row__title {
    color: var(--c-accent);
    text-shadow: var(--text-glow-sm);
  }

  .service-row__desc {
    grid-area: desc;
    max-width: 34rem;
    margin-block-start: var(--sp-2xs);
    color: var(--c-fg-muted);
    text-wrap: pretty;
  }

  .service-row__tag {
    grid-area: tag;
    display: flex;
    align-items: center;
    gap: var(--sp-2xs);
    margin-block-start: var(--sp-2xs);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg-faint);
  }

  /* La flecha avanza con el cursor: el mismo desplazamiento que ya hacen los
     enlaces de `apply`, para que el vocabulario de la página sea uno solo. */
  .service-row__tag::before {
    content: '→';
    color: var(--c-accent);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .service-row:hover .service-row__tag::before {
    transform: translateX(4px);
  }

  .service-row__label {
    grid-area: label;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-faint);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    /* La etiqueta de periodicidad pasa a la cabecera de la fila: mantenerla en
       una tercera columna estrangulaba el titular a dos caracteres por línea. */
    .service-row {
      grid-template-columns: auto 1fr;
      grid-template-areas: 'num label' 'num title' 'num desc' 'num tag';
      column-gap: var(--sp-md);
    }

    .service-row__label {
      margin-block-end: var(--sp-2xs);
    }

    .service-row__title {
      font-size: var(--fs-2xl);
    }
  }

  /* --- Roster / marquee ------------------------------------------------- */
  .roster__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-md);
    margin-block-end: var(--sp-xl);
  }

  .roster__title {
    font-size: var(--fs-3xl);
  }

  .roster__meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    color: var(--c-fg-faint);
  }

  .marquee {
    overflow: hidden;
    padding-block: var(--sp-sm);
    border-top: 1px solid var(--c-border);
    /* Los nombres se disuelven en los bordes en vez de cortarse contra el
       viewport: sin esto la cinta parece una tabla recortada, no un desfile. */
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-left 42s linear infinite;
  }

  .marquee__track--b {
    animation-name: marquee-right;
    animation-duration: 50s;
  }

  /* Al pasar por encima la cinta se detiene para poder leer un nombre. */
  .roster:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    padding-inline-end: var(--sp-lg);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    text-transform: uppercase;
    color: var(--c-fg-muted);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .marquee__item:hover {
    color: var(--c-fg);
  }

  .marquee__dot {
    width: 5px;
    height: 5px;
    margin-inline-start: var(--sp-lg);
    background: var(--c-accent);
    border-radius: 50%;
    box-shadow: var(--glow-xs);
  }

  @keyframes marquee-left {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  .roster__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-sm);
    margin-block-start: var(--sp-lg);
    padding-block-start: var(--sp-md);
    border-top: 1px solid var(--c-border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .roster__cta {
    color: var(--c-fg);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .roster__cta:hover {
    color: var(--c-accent);
    text-shadow: var(--text-glow-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track,
    .hero__aura,
    .hero__scroll-cue {
      animation: none;
    }
  }

  /* --- Apply -------------------------------------------------------------- */
  .apply {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 0;
  }

  .apply__col {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-xl);
    padding: var(--sp-2xl) var(--gutter);
    border-top: 1px solid var(--c-border);
    transition: background var(--dur-slow) var(--ease-out);
  }

  /* Las dos columnas se iluminan hacia dentro, cada una desde su borde
     exterior: son las dos hojas de la puerta a escala de sección. */
  .apply__col:hover {
    background: radial-gradient(
