---
import Layout from '../layouts/Layout.astro'
import ContactForm from '../components/ContactForm.astro'
import DoorMark from '../components/DoorMark.astro'
import Logo from '../components/Logo.astro'
import { SITE } from '../data/navigation'

const services = [
  {
    num: '01',
    title: 'Venue Programming',
    desc: 'Construimos el calendario — residencias, takeovers, noches temáticas. Desde el soft opening hasta el primer aniversario, tu local no se apaga nunca.',
    tag: 'Calendars, residencies, takeovers',
    label: 'Ongoing',
  },
  {
    num: '02',
    title: 'Guest Curation',
    desc: 'Un guest list completamente curado de más de 1.2k de potenciales invitados a tu evento. El guest list solo se abre para la gente que convierte un miércoles en un sábado — la combinación perfecta, el momentum, el mood.',
    tag: 'VIP database, our guest list is never shared, and never sold',
    label: 'Per night',
  },
  {
    num: '03',
    title: 'Private & VIP',
    desc: 'Cumpleaños. Lanzamientos. Reservas corporativas. Nosotros manejamos el evento, el lugar y la coordinación — tú solo te preocupas por disfrutar el momento.',
    tag: 'Birthdays, launches, corporate events',
    label: 'One-off',
  },
  {
    num: '04',
    title: 'Door & Floor',
    desc: 'Nos encargamos de la supervisión, PR y equipo de imagen. Coordinamos en tiempo real, para que tu evento genere controversia.',
    tag: 'Live coordination, PR team, models',
    label: 'Per night',
  },
  {
    num: '05',
    title: 'Media & Visibility',
    desc: 'Notas de prensa y publicidad estratégica. La mención correcta en el medio correcto y en el momento correcto. Hacemos que se hable de tu evento en el círculo indicado.',
    tag: 'Press, content, influencers',
    label: 'Retainer',
  },
]

/**
 * Los títulos que llevan «&» se parten en tres: lo que va antes del signo
 * queda en blanco, el signo en la cursiva de acento y la palabra siguiente
 * en rojo. Los que no lo llevan se quedan enteros en blanco.
 */
const serviceRows = services.map((service) => {
  const [head, accent] = service.title.split('&')

  return {
    ...service,
    titleHead: accent ? head.trim() : service.title,
    titleAccent: accent ? accent.trim() : '',
  }
})

const stats = [
  {
    num: '1.2k',
    desc: 'De clientes VIP en nuestra base de datos completamente curada para llenar tu evento con el público indicado.',
  },
  { num: '24/7', desc: 'Tú lo necesitas, nosotros lo creamos.' },
]
---

<Layout
  title={`${SITE.name} — Public relations for hospitality & nightlife in Lima`}
  description={`${SITE.description} ${SITE.proposition} Lima, Perú.`}
  intro
  soon
>
  <section id="top" class="hero" data-door-scene>
    <div class="container hero__inner">
      <div class="hero__topbar">
        <span>{SITE.city}</span>
        <span class="hero__topbar-right">
          <em>— Solo miembros —</em>
          <span>MMXXVI</span>
        </span>
      </div>

      <div class="hero__stage">
        <DoorMark class="hero__mark" id="hero" staged />
        <Logo class="hero__wordmark" />
        <span class="hero__rule" aria-hidden="true"></span>
      </div>

      <p class="hero__tagline display">
        Doors don’t open for everyone — <em>but we can open them for you.</em>
      </p>

      <div class="hero__foot">
        <p class="hero__eyebrow">{SITE.description.toUpperCase()}</p>
        <a class="hero__scroll" href="#services">
          <span class="hero__scroll-label">After hours / 01 — 03</span>
          <span class="hero__scroll-cue" aria-hidden="true"></span>
          <span class="hero__scroll-word">Baja</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section question">
    <div class="container">
      <p class="eyebrow" data-reveal>— The question</p>
      <h2 class="question__title">
        <span data-reveal>Are you in?</span>
        <em data-reveal>Or are you out?</em>
      </h2>
      <p class="manifesto" data-reveal>
        Anyone can just fill a room — <em>we fill it with the right people that will
        come back.</em>
      </p>

      <p class="manifesto__note" data-reveal>{SITE.proposition}</p>
    </div>

    <div class="container stat-grid">
      {
        stats.map((stat) => (
          <div class="stat-grid__item" data-reveal>
            <p class="stat-grid__num">{stat.num}</p>
            <p class="stat-grid__desc">{stat.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section id="services" class="section services">
    <div class="container services__head">
      <p class="eyebrow" data-reveal>— What we do</p>
      <h2 class="services__title" data-reveal>
        The Door PR is for venues that take the door seriously.
      </h2>
    </div>

    <div class="container">
      {
        serviceRows.map((service) => (
          <div class="service-row" data-reveal>
            <span class="service-row__num">{service.num} /</span>
            <h3 class="service-row__title">
              {service.titleHead}
              {service.titleAccent && (
                <>
                  {' '}
                  <span class="service-row__amp">&</span> <em>{service.titleAccent}</em>
                </>
              )}
            </h3>
            <p class="service-row__desc">{service.desc}</p>
            <span class="service-row__tag">
              <span class="service-row__arrow" aria-hidden="true">→</span> {service.tag}
            </span>
            <span class="service-row__label">{service.label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section id="contact" class="section knock">
    <div class="container knock__head">
      <p class="eyebrow" data-reveal>— Contact</p>
      <h2 class="knock__title" data-reveal>
        Knock once. <em>We’ll answer.</em>
      </h2>
    </div>

    <div class="knock__cols">
      <div class="knock__col" id="apply" data-reveal>
        <p class="eyebrow">— For venues</p>
        <h3 class="knock__col-title">Put us on the door.</h3>
        <p class="knock__desc">
          Bares, hoteles, restaurantes. Nos hacemos cargo de tu evento 24/7 —
          silenciosamente, consistentemente y con los invitados correctos. Cuéntanos
          del local y la noche que quieres crear.
        </p>

        <ul role="list" class="knock__bullets">
          <li>Aceptamos 4 locales nuevos por trimestre</li>
          <li>Compromiso mínimo de 6 meses</li>
          <li>Referencias bajo pedido</li>
        </ul>

        <ContactForm
          id="venues"
          kind="venue"
          messageLabel="Pitch your venue →"
          messagePlaceholder="El local, la noche que quieres crear y cuándo."
        />
      </div>

      <div class="knock__col knock__col--list" data-reveal>
        <p class="eyebrow">— For the list</p>
        <h3 class="knock__col-title">Get on the guest list.</h3>
        <p class="knock__desc">
          Si quieres ser parte de nuestro guest list y así recibir el primer aviso de
          residencias, aperturas y salones privados en nuestros locales. Sin app. Sin
          cobro. Solo por referencia — puedes presentarte.
        </p>

        <ul role="list" class="knock__bullets">
          <li>Tus datos nunca se comparten</li>
          <li>Puedes referir de tres a cinco invitaciones por mes</li>
          <li>Te das de baja cuando quieras</li>
        </ul>

        <ContactForm
          id="guests"
          kind="guest"
          messageLabel="Request an introduction →"
          messagePlaceholder="Quién te refiere y qué noches te mueves."
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* --- Hero ------------------------------------------------------------- */
  /* La altura la fija el hero (pantalla menos cabecera) y el inner la
     rellena: así el padding no se suma por fuera y la portada cabe justa. */
  .hero {
    display: grid;
    min-height: calc(100svh - 4.75rem);
    padding-block: var(--sp-lg);
  }

  .hero__inner {
    display: grid;
    align-content: space-between;
    gap: clamp(var(--sp-sm), 3vh, var(--sp-lg));
  }

  .hero__topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .hero__topbar-right {
    display: flex;
    gap: var(--sp-md);
    color: var(--c-fg-muted);
  }

  .hero__topbar-right em {
    font-style: normal;
    color: var(--c-accent);
    text-shadow: var(--glow-label);
  }

  @media (max-width: 600px) {
    .hero__topbar-right em {
      display: none;
    }
  }

  .hero__stage {
    display: grid;
    justify-items: center;
    gap: clamp(var(--sp-sm), 2.5vh, var(--sp-lg));
    text-align: center;
  }

  /* La puerta es el titular de la portada. Se mide por ALTURA —que es lo
     que compite con el resto del hero— y el aspect-ratio deduce el ancho,
     así nunca empuja la portada fuera de la primera pantalla. */
  :global(.hero__mark) {
    aspect-ratio: 24 / 34;
    width: auto;
    height: min(46vh, 34rem);
    max-width: 86vw;
  }

  :global(.hero__wordmark) {
    font-size: var(--fs-2xl);
  }

  .hero__rule {
    width: 2.5rem;
    height: 1px;
    background: var(--c-accent);
    box-shadow: var(--glow-accent);
  }

  /* Misma tipografía que «Are you in?»: el titular de display de la marca,
     no la itálica de cuerpo. La segunda mitad se queda en itálica roja. */
  .hero__tagline {
    max-width: var(--measure-lg);
    margin-inline: auto;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: var(--ls-normal);
    text-align: center;
    color: var(--c-fg);
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-md);
    align-items: flex-end;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  /* El posicionamiento es la frase que explica de qué va la casa: se lee
     antes que el resto del pie, así que pesa más que el resto del pie. */
  .hero__eyebrow {
    max-width: 34rem;
    font-size: var(--fs-base);
    line-height: 1.5;
    letter-spacing: var(--ls-normal);
    color: var(--c-fg);
  }

  .hero__scroll {
    display: inline-flex;
    gap: var(--sp-xs);
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hero__scroll:hover {
    color: var(--c-fg);
  }

  /* Filete vertical que cae: dice hacia dónde se baja, que es lo que un
     indicador de scroll tiene que decir. El guion horizontal anterior no lo
     decía y además partía la frase por la mitad. */
  .hero__scroll-cue {
    position: relative;
    width: 1px;
    height: 1.75rem;
    overflow: hidden;
    background: var(--c-border-strong);
  }

  .hero__scroll-cue::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 60%;
    background: var(--c-accent);
    box-shadow: 0 0 8px var(--c-accent);
    animation: scroll-cue 2.6s var(--ease-in-out) infinite;
  }

  .hero__scroll-word {
    color: var(--c-fg);
  }

  /* En móvil el hero se pasaba unos píxeles de la pantalla y obligaba a hacer
     scroll solo para ver el indicador. El relleno vertical es lo que sobra. */
  @media (max-width: 600px) {
    .hero {
      padding-block: var(--sp-md);
    }
  }

  @keyframes scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(200%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-cue::after {
      animation: none;
    }
  }

  /* --- Entrada coreografiada del hero -------------------------------------
     Los textos entran detrás de la puerta, escalonados. El estado inicial solo
     se aplica con JS: sin él todo es visible desde el primer pintado.
     ---------------------------------------------------------------------- */

  :global(html.js) .hero__rule,
  :global(html.js) .hero__tagline,
  :global(html.js) .hero__foot,
  :global(html.js) .hero__stage :global(.hero__wordmark) {
    opacity: 0;
  }

  /* Apertura completa: la puerta acaba a los 4,4 s y el texto la remata. */
  .hero.scene--enter :global(.hero__wordmark) {
    animation: hero-rise 1000ms var(--ease-out) 3600ms both;
  }

  .hero.scene--enter .hero__rule {
    animation: hero-rule 900ms var(--ease-out) 3800ms both;
  }

  .hero.scene--enter .hero__tagline {
    animation: hero-rise 1100ms var(--ease-out) 3950ms both;
  }

  .hero.scene--enter .hero__foot {
    animation: hero-rise 1000ms var(--ease-out) 4250ms both;
  }

  /* Tras el intro la puerta solo se asienta, así que el texto entra enseguida. */
  .hero.scene--settle :global(.hero__wordmark) {
    animation: hero-rise 700ms var(--ease-out) 250ms both;
  }

  .hero.scene--settle .hero__rule {
    animation: hero-rule 600ms var(--ease-out) 400ms both;
  }

  .hero.scene--settle .hero__tagline {
    animation: hero-rise 800ms var(--ease-out) 500ms both;
  }

  .hero.scene--settle .hero__foot {
    animation: hero-rise 700ms var(--ease-out) 700ms both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* El filete no aparece: se abre desde el centro, como la propia puerta. */
  @keyframes hero-rule {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__rule,
    :global(html.js) .hero__tagline,
    :global(html.js) .hero__foot,
    :global(html.js) .hero__stage :global(.hero__wordmark) {
      opacity: 1;
    }
  }

  /* --- Question / stats --------------------------------------------------- */
  .question__title {
    display: grid;
    margin-block-start: var(--sp-md);
    font-size: var(--fs-5xl);
    line-height: 0.95;
  }

  /* El manifiesto lleva la tipografía del wordmark —THE DOOR PR— con un
     punto de tracking, para que suene a la marca y no a texto corrido. */
  .manifesto {
    max-width: var(--measure-lg);
    margin-block-start: var(--sp-xl);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1.3;
    letter-spacing: 0.04em;
    color: var(--c-fg-muted);
  }

  .manifesto em {
    font-style: normal;
    color: var(--c-fg);
  }

  .manifesto__note {
    max-width: var(--measure-md);
    margin-block-start: var(--sp-md);
    padding-inline-start: var(--sp-sm);
    border-inline-start: 1px solid var(--c-border-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-base);
    line-height: 1.8;
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg);
  }

  .stat-grid {
    display: grid;
    /* Dos cifras: conviven en una línea y se apilan solas cuando no caben. */
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--sp-lg) clamp(var(--sp-lg), 4vw, var(--sp-2xl));
    margin-block-start: var(--sp-2xl);
    padding-block-start: var(--sp-lg);
    border-top: 1px solid var(--c-border);
  }

  .stat-grid__num {
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    text-transform: uppercase;
    color: var(--c-fg);
  }

  .stat-grid__desc {
    max-width: var(--measure-sm);
    margin-block-start: var(--sp-2xs);
    font-size: var(--fs-base);
    color: var(--c-fg-muted);
  }

  /* --- Services ------------------------------------------------------------ */
  .services__head {
    display: grid;
    gap: var(--sp-md);
    margin-block-end: var(--sp-xl);
  }

  .services__title {
    max-width: var(--measure-md);
    font-size: var(--fs-3xl);
  }

  .service-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'num title label' 'num desc label' 'num tag label';
    column-gap: var(--sp-lg);
    row-gap: var(--sp-2xs);
    align-items: start;
    padding-block: var(--sp-lg);
    border-top: 1px solid var(--c-border);
  }

  .service-row:last-child {
    border-bottom: 1px solid var(--c-border);
  }


  .service-row__num {
    grid-area: num;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--c-accent);
  }

  /* Italiana en redonda, como todos los titulares: la cursiva inclinada a la
     fuerza deformaba la letra. La inclinación la aporta solo el acento. */
  .service-row__title {
    grid-area: title;
    font-size: var(--fs-3xl);
  }

  /* El «&» va en la cursiva de acento pero en crema: une las dos mitades sin
     encenderse. El de Italiana se leía como una «e» tachada. */
  .service-row__amp {
    font-family: var(--font-accent);
    font-size: var(--fs-accent-scale);
    font-style: italic;
    font-weight: var(--fw-regular);
    color: var(--c-fg);
  }

  /* La descripción es un párrafo, y los párrafos del sitio van en Archivo:
     en Italiana, fina y en gris, cinco líneas se leían con esfuerzo. */
  .service-row__desc {
    grid-area: desc;
    max-width: var(--measure-sm);
    margin-block-start: var(--sp-2xs);
    font-size: var(--fs-lg);
    font-weight: 300;
    line-height: var(--lh-normal);
    color: var(--c-fg-muted);
  }

  /* La etiqueta es un dato, no un titular: va en gris y solo la flecha
     conserva el rojo, que así no le disputa el brillo al título. */
  .service-row__tag {
    grid-area: tag;
    display: block;
    margin-block-start: var(--sp-2xs);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .service-row__arrow {
    color: var(--c-accent);
  }

  .service-row__label {
    grid-area: label;
    align-self: start;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-fg-muted);
    white-space: nowrap;
  }

  /* En móvil la tercera columna no cabe: la etiqueta sube a la línea del
     número y el resto de la fila ocupa el ancho completo. */
  @media (max-width: 700px) {
    .service-row {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'num label'
        'title title'
        'desc desc'
        'tag tag';
      column-gap: var(--sp-md);
    }

    .service-row__label {
      justify-self: end;
    }

    .service-row__title {
      margin-block-start: var(--sp-2xs);
    }
  }

  /* A partir de laptop ancha la fila apilada dejaba medio metro de vacío a la
     derecha: título y texto pasan a convivir en cuatro columnas, así la fila
     ocupa el ancho completo sin estirar ninguna medida de lectura. */
  @media (min-width: 1100px) {
    .service-row {
      grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr) auto;
      grid-template-areas:
        'num title desc label'
        'num title tag label';
      column-gap: clamp(var(--sp-lg), 4vw, var(--sp-2xl));
      padding-block: var(--sp-xl);
    }

    .service-row__title {
      align-self: start;
      max-width: 16ch;
    }

    .service-row__desc {
      max-width: var(--measure-md);
      margin-block-start: 0;
    }
  }

  /* --- Knock (contacto) ---------------------------------------------------- */
  .knock {
    padding-block-end: 0;
  }

  .knock__head {
    margin-block-end: var(--sp-xl);
  }

  .knock__title {
    max-width: var(--measure-md);
    margin-block-start: var(--sp-md);
    font-size: var(--fs-4xl);
    line-height: 0.95;
  }

  .knock__title em {
    display: block;
  }

  /* Las dos puertas —local e invitada— van en línea y con el mismo peso:
     ninguna de las dos es la principal. */
  .knock__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .knock__col {
    display: flex;
    flex-direction: column;
    padding: var(--sp-2xl) var(--gutter);
    background: var(--c-bg);
    border-top: 1px solid var(--c-border);
    transition: background var(--dur-base) var(--ease-out);
  }

  .knock__col:hover {
    background: var(--c-bg-elevated);
  }

  .knock__col--list {
    border-inline-start: 1px solid var(--c-border);
  }

  .knock__col-title {
    margin-block-start: var(--sp-md);
    font-size: clamp(2rem, 1.3rem + 3vw, 4rem);
    text-wrap: balance;
  }

  .knock__desc {
    max-width: 30rem;
    margin-block: var(--sp-md) var(--sp-lg);
    color: var(--c-fg-muted);
  }

  /* El empujón hacia abajo alinea los dos formularios entre sí aunque los
     textos de encima midan distinto: las dos columnas son igual de altas. */
  .knock__bullets {
    display: grid;
    margin-block-start: auto;
    gap: var(--sp-2xs);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-normal);
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .knock__bullets li {
    padding-block: var(--sp-sm);
    border-top: 1px solid var(--c-border);
  }

  .knock__bullets li::before {
    content: '• ';
    color: var(--c-accent);
  }

  @media (max-width: 860px) {
    .knock__cols {
      grid-template-columns: 1fr;
    }

    .knock__col--list {
      border-inline-start: 0;
    }
  }
