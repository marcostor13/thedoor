---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Intro from '../components/Intro.astro'
import ComingSoon from '../components/ComingSoon.astro'

interface Props {
  title: string
  description?: string
  /** La animación de entrada solo se muestra en la portada. */
  intro?: boolean
  /**
   * Cabecera y pie del sitio. Las landings de campaña —el enlace que se
   * reparte por WhatsApp o correo— se sirven sin ellos: si hay navegación,
   * la página deja de ser una invitación y vuelve a ser la web.
   */
  chrome?: boolean
  /** Un enlace que se reparte a mano no se anuncia en buscadores. */
  noindex?: boolean
  /**
   * Deja la página detrás de la verja de «próximamente»
   * (components/ComingSoon.astro): solo se ve la puerta, y la página real
   * asoma con `?develop=true`. Es cosa de la web —las landings que ya
   * están operativas se sirven enteras.
   */
  soon?: boolean
}

const {
  title,
  description = 'The Door PR — casa de relaciones públicas para hospitalidad, vida nocturna y la gente que llena las salas. Lima, Perú.',
  intro = false,
  chrome = true,
  noindex = false,
  soon = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="es" data-soon={soon ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#ff1a25" />
    <meta name="theme-color" content="#000000" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Italiana&family=Cormorant+Garamond:ital,wght@1,300;1,400;1,500&family=Archivo:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <ClientRouter />

    <script is:inline>
      // Marca que hay JS antes de pintar, para que el CSS de revelado no
      // esconda contenido en navegadores sin JavaScript.
      document.documentElement.classList.add('js')

      // Verja de «próximamente»: `?develop=true` abre la web y el permiso
      // dura la sesión; `?develop=false` la vuelve a cerrar. Tiene que
      // resolverse AQUÍ —síncrono y antes del <body>— o la portada
      // parpadearía antes de taparse. scripts/gate.ts repite la jugada en las
      // navegaciones del ClientRouter.
      try {
        var develop = new URLSearchParams(location.search).get('develop')
        if (develop === 'true') sessionStorage.setItem('thedoor:develop', '1')
        else if (develop === 'false') sessionStorage.removeItem('thedoor:develop')
        if (sessionStorage.getItem('thedoor:develop') === '1') {
          document.documentElement.dataset.develop = 'true'
        }
      } catch (error) {
        if (develop === 'true') document.documentElement.dataset.develop = 'true'
      }
    </script>
  </head>

  <body>
    {soon && <ComingSoon />}

    {chrome && <a class="skip-link" href="#main">Saltar al contenido</a>}

    {intro && <Intro />}

    {chrome && <Header />}

    <main id="main">
      <slot />
    </main>

    {chrome && <Footer />}

    <script>
      import { initReveal } from '../scripts/reveal'
      import { initHeroDoor } from '../scripts/door'
      import { initGate } from '../scripts/gate'

      // La verja va primero: si hay acceso, se retira antes de que la puerta
      // del hero busque quién anima a quién.
      initGate()
      initReveal()
      initHeroDoor()

      document.addEventListener('astro:after-swap', () => {
        initGate()
        initReveal()
        initHeroDoor()
      })
    </script>
  </body>
</html>
